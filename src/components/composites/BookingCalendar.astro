---
// Mock-UI composite: an online booking grid. Some slots booked, one "new".
// Class hooks: .slot for staggered fill, .slot-new for the highlighted booking.
const days = ["M", "T", "W", "T", "F"];
// state: 0 open, 1 booked, 2 the freshly-booked highlight
const grid = [
  [1, 0, 1, 0, 1],
  [0, 1, 0, 2, 0],
  [1, 0, 1, 0, 1],
];
const times = ["9a", "11a", "2p"];
---

<div class="composite booking w-full rounded-xl bg-white border border-fog shadow-soft overflow-hidden select-none">
  <div class="flex items-center justify-between px-4 py-3 border-b border-fog/80">
    <div class="flex items-center gap-2">
      <span class="w-5 h-5 rounded-md bg-signal/20 grid place-items-center">
        <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="text-forest">
          <rect x="1.5" y="2.5" width="11" height="10" rx="2" stroke="currentColor" stroke-width="1.3"/>
          <path d="M1.5 5.5h11M4.5 1v2M9.5 1v2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="text-[13px] font-display font-bold tracking-tight text-ink">Book a time</span>
    </div>
    <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-graphite/55">This week</span>
  </div>

  <div class="p-4">
    <div class="grid grid-cols-[auto_repeat(5,1fr)] gap-1.5 items-center">
      <span></span>
      {days.map((d) => <span class="text-[9px] font-mono text-graphite/55 text-center">{d}</span>)}
      {
        grid.map((row, r) => (
          <>
            <span class="text-[9px] font-mono text-graphite/55 pr-1 text-right">{times[r]}</span>
            {row.map((cell) => (
              <span
                class={`slot h-6 rounded-md ${
                  cell === 0
                    ? "bg-bone border border-fog"
                    : cell === 2
                      ? "slot-new bg-ember/15 border border-ember grid place-items-center"
                      : "bg-forest/10 border border-forest/20"
                }`}
              >
                {cell === 2 && <span class="w-1.5 h-1.5 rounded-full bg-ember"></span>}
              </span>
            ))}
          </>
        ))
      }
    </div>

    <div class="slot-new-toast mt-3 flex items-center gap-2 rounded-lg bg-forest text-bone px-3 py-2">
      <span class="w-1.5 h-1.5 rounded-full bg-signal"></span>
      <span class="text-[10px] font-medium">New booking confirmed</span>
      <span class="ml-auto text-[9px] font-mono text-bone/70">Wed 2p</span>
    </div>
  </div>
</div>
