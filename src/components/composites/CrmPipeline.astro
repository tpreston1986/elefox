---
// Mock-UI composite: a relationship-first CRM pipeline board.
// Illustrative sample data (not real client facts) for a product mockup.
// Class hooks (.crm-col, .crm-deal, .crm-bar) drive GSAP stagger/assemble.
const columns = [
  {
    name: "New",
    count: 4,
    deals: [
      { who: "Coastal Law Group", val: "$12k", tag: "Website" },
    ],
  },
  {
    name: "Qualified",
    count: 3,
    deals: [
      { who: "Lumen Dental", val: "$24k", tag: "CRM" },
      { who: "Ridge & Co.", val: "$8k", tag: "Brand" },
    ],
  },
  {
    name: "Proposal",
    count: 2,
    deals: [{ who: "Harbor Wealth", val: "$31k", tag: "Portal" }],
  },
  {
    name: "Won",
    count: 5,
    deals: [{ who: "Sunset Studio", val: "$18k", tag: "CRM", won: true }],
  },
];
---

<div class="composite crm w-full rounded-xl bg-white border border-fog shadow-soft overflow-hidden select-none">
  <!-- title bar -->
  <div class="flex items-center justify-between px-4 py-3 border-b border-fog/80">
    <div class="flex items-center gap-2">
      <span class="w-5 h-5 rounded-md bg-forest/12 grid place-items-center">
        <span class="w-2 h-2 rounded-[3px] bg-forest"></span>
      </span>
      <span class="text-[13px] font-display font-bold tracking-tight text-ink">Pipeline</span>
    </div>
    <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-graphite/60">This month</span>
  </div>

  <!-- board -->
  <div class="grid grid-cols-4 gap-2 p-3">
    {
      columns.map((col) => (
        <div class="crm-col flex flex-col gap-2 min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] font-mono uppercase tracking-[0.1em] text-graphite/70 truncate">
              {col.name}
            </span>
            <span class="text-[9px] font-mono text-graphite/45">{col.count}</span>
          </div>
          {col.deals.map((d) => (
            <div
              class={`crm-deal rounded-lg border p-2.5 ${d.won ? "border-ember/40 bg-ember/5" : "border-fog bg-bone/60"}`}
            >
              <div class="flex items-center justify-between gap-1">
                <span class="text-[11px] font-semibold text-ink truncate">{d.who}</span>
                {d.won && <span class="w-1.5 h-1.5 rounded-full bg-ember shrink-0" />}
              </div>
              <div class="flex items-center justify-between mt-1.5">
                <span class={`text-[9px] font-mono px-1.5 py-0.5 rounded ${d.won ? "text-ember bg-ember/10" : "text-forest bg-forest/8"}`}>
                  {d.tag}
                </span>
                <span class="text-[10px] font-mono text-graphite/70">{d.val}</span>
              </div>
            </div>
          ))}
          {/* progress sliver at the column base */}
          <span class="crm-bar mt-auto h-1 rounded-full bg-forest/15 overflow-hidden block">
            <span class="block h-full w-2/3 rounded-full bg-forest/45"></span>
          </span>
        </div>
      ))
    }
  </div>
</div>
