---
// Mock-UI composite: a website in a browser frame. A looping cursor drifts
// to the hero CTA and "clicks" it. Class hooks: .site-cursor, .site-cta,
// .site-hero (driven by the loop in index.astro).
---

<div class="composite website w-full rounded-xl bg-white border border-fog shadow-soft overflow-hidden select-none">
  <!-- browser chrome -->
  <div class="flex items-center gap-3 px-3 py-2.5 border-b border-fog/80 bg-bone/50">
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-mist"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-mist"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-mist"></span>
    </div>
    <div class="flex-1 mx-2 h-5 rounded-md bg-bone border border-fog/80 grid place-items-center">
      <span class="font-mono text-[9px] text-graphite/55">yourbrand.com</span>
    </div>
  </div>

  <!-- page -->
  <div class="relative p-5">
    <!-- mini nav -->
    <div class="flex items-center justify-between mb-5">
      <span class="text-[12px] font-display font-extrabold tracking-tight text-ink">brand</span>
      <div class="hidden sm:flex items-center gap-3">
        <span class="h-1.5 w-7 rounded-full bg-graphite/15"></span>
        <span class="h-1.5 w-7 rounded-full bg-graphite/15"></span>
        <span class="h-1.5 w-7 rounded-full bg-graphite/15"></span>
      </div>
      <span class="text-[9px] font-medium px-2 py-1 rounded-pill bg-ink text-bone">Book</span>
    </div>

    <!-- hero -->
    <div class="site-hero text-center py-3">
      <div class="h-3.5 w-3/4 mx-auto rounded bg-ink/85 mb-2"></div>
      <div class="h-3.5 w-1/2 mx-auto rounded bg-ink/85 mb-3"></div>
      <div class="h-2 w-2/3 mx-auto rounded bg-graphite/25 mb-4"></div>
      <span class="site-cta inline-block px-4 py-2 rounded-pill bg-forest text-bone text-[10px] font-medium">
        Get started
      </span>
    </div>

    <!-- feature row -->
    <div class="grid grid-cols-3 gap-2 mt-5">
      {[0, 1, 2].map(() => (
        <div class="rounded-lg border border-fog bg-bone/50 p-2">
          <span class="block w-5 h-5 rounded-md bg-forest/12 mb-2"></span>
          <span class="block h-1.5 w-full rounded bg-graphite/15 mb-1"></span>
          <span class="block h-1.5 w-2/3 rounded bg-graphite/10"></span>
        </div>
      ))}
    </div>

    <!-- looping cursor -->
    <span class="site-cursor absolute left-0 top-0 z-10 pointer-events-none opacity-0" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
        <path d="M2 1.5l11 5.5-4.7 1.3L6 14 2 1.5z" fill="white" stroke="#1A1F1B" stroke-width="1.1" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</div>
