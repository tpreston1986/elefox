---
// Persistent, non-dismissible top bar that marks every demo page as a concept.
// Colored in elefox brand (forest + bone) so it visually reads as Tiffany's
// overlay sitting on top of the client's mockup, not part of their design.

type Props = { clientName: string };
const { clientName } = Astro.props;
---

<div
  role="note"
  aria-label="Demo notice"
  class="demo-banner"
>
  <span class="demo-banner__dot" aria-hidden="true"></span>
  <span>
    Concept demo for <strong>{clientName}</strong>
    <span class="demo-banner__sep">·</span> prepared by elefox studio
    <span class="demo-banner__sep">·</span> not a live product
  </span>
</div>

<!-- spacer so fixed banner doesn't sit on top of the first section -->
<div class="demo-banner__spacer" aria-hidden="true"></div>

<style>
  .demo-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #1a1f1b;
    color: #f7f4ed;
    font-family:
      "Inter",
      ui-sans-serif,
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 9px 16px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
    text-align: center;
  }

  .demo-banner strong {
    font-weight: 600;
    color: #d4a574;
  }

  .demo-banner__sep {
    opacity: 0.5;
    margin: 0 4px;
  }

  .demo-banner__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #c8623a;
    box-shadow: 0 0 0 3px rgba(200, 98, 58, 0.18);
  }

  .demo-banner__spacer {
    height: 38px;
  }

  @media (max-width: 540px) {
    .demo-banner {
      font-size: 11.5px;
      padding: 8px 12px;
    }
    .demo-banner__spacer {
      height: 34px;
    }
  }
</style>
