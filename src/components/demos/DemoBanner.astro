---
// Persistent, non-dismissible top bar that marks every demo page as a concept.
// Uses the CLIENT'S brand colors (via CSS vars set by DemoLayout) so the bar
// reads as part of their visual system — not a vendor stamp from us.
// No elefox attribution: the demo is meant to feel like the prospect's site
// with a discreet "this is a concept" indicator, not a co-branded thing.

type Props = { clientName: string };
const { clientName } = Astro.props;
---

<div role="note" aria-label="Demo notice" class="demo-banner">
  <span class="demo-banner__dot" aria-hidden="true"></span>
  <span>
    Concept demo for <strong>{clientName}</strong>
    <span class="demo-banner__sep">·</span> not a live product
  </span>
</div>

<!-- spacer so fixed banner doesn't sit on top of the first section -->
<div class="demo-banner__spacer" aria-hidden="true"></div>

<style>
  /* All colors flow from the client's brand vars (set by DemoLayout).
     This way the bar always looks like part of the client's design system,
     never an elefox-colored overlay. */
  .demo-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--brandText);
    color: var(--brandBg);
    font-family: var(--brandBodyFont);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 9px 16px;
    text-align: center;
  }

  .demo-banner strong {
    font-weight: 600;
    color: var(--brandBg);
  }

  .demo-banner__sep {
    opacity: 0.5;
    margin: 0 4px;
  }

  .demo-banner__dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--brandAccent);
    opacity: 0.95;
  }

  .demo-banner__spacer {
    height: 38px;
  }

  @media (max-width: 540px) {
    .demo-banner {
      font-size: 11.5px;
      padding: 8px 12px;
    }
    .demo-banner__spacer {
      height: 34px;
    }
  }
</style>
