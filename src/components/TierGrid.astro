---
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";
import type { Tier } from "../data/services";

type Props = {
  tiers: Tier[];
  heading?: string;
  eyebrow?: string;
};

const { tiers, heading, eyebrow } = Astro.props;
---

<section class="py-20 md:py-32 bg-cream">
  <Container size="full">
    {
      (heading || eyebrow) && (
        <div class="mb-16 md:mb-20 max-w-3xl">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          {heading && <h2 class="mt-6">{heading}</h2>}
        </div>
      )
    }

    <div
      class={`grid grid-cols-1 ${
        tiers.length >= 4
          ? "md:grid-cols-2 lg:grid-cols-4"
          : tiers.length === 3
          ? "md:grid-cols-3"
          : "md:grid-cols-2"
      } gap-6 md:gap-8`}
    >
      {
        tiers.map((tier) => (
          <article
            class={`relative bg-white border border-fog rounded-xl p-8 md:p-10 flex flex-col ${
              tier.badge ? "ring-1 ring-forest" : ""
            }`}
          >
            {tier.badge && (
              <span class="absolute -top-3 left-8 bg-forest text-bone text-xs font-mono uppercase tracking-wider px-3 py-1 rounded-pill">
                {tier.badge}
              </span>
            )}

            <h3 class="text-2xl md:text-3xl text-ink mb-3">{tier.name}</h3>

            <div class="mb-6">
              <div class="flex items-baseline gap-2 flex-wrap">
                <span class="text-3xl md:text-4xl font-display font-bold text-forest tracking-tight">
                  {tier.price}
                </span>
                {tier.cadence && (
                  <span class="text-sm text-graphite">{tier.cadence}</span>
                )}
              </div>
            </div>

            <p class="text-graphite leading-relaxed mb-8">{tier.blurb}</p>

            <ul class="space-y-3 mb-8 flex-1">
              {tier.features.map((f) => (
                <li class="flex items-start gap-3 text-sm">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    class="text-forest mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 8.5L6 11.5L13 4.5"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class="text-ink">{f}</span>
                </li>
              ))}
            </ul>

            <a
              href={tier.cta?.href ?? "/contact"}
              class="inline-flex items-center justify-center gap-2 px-5 py-3 border border-mist hover:border-forest text-ink hover:text-forest rounded-pill text-sm font-medium transition-colors"
            >
              {tier.cta?.label ?? "Get started"}
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </Container>
</section>
