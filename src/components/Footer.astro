---
import Container from "./Container.astro";
import { footerNav } from "../data/nav";

const year = new Date().getFullYear();
---

<footer class="pt-6 md:pt-10 pb-2 md:pb-4">
  <Container size="full">
    <div class="bg-ink text-bone rounded-[28px] md:rounded-[40px] px-6 sm:px-10 md:px-16 pt-16 md:pt-20 pb-10 md:pb-12">
      <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-5">
        <img
          src="/brand/logo-horizontal-white.png"
          alt="elefox studio"
          class="h-8 w-auto mb-6"
          width="180"
          height="40"
        />
        <p class="text-bone/70 text-lg leading-relaxed max-w-md">
          A design and product studio. We build the websites, internal tools,
          and quiet automations that small companies grow on.
        </p>

        <div class="mt-10 max-w-md">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 bg-bone text-ink font-medium rounded-pill hover:bg-cream transition-colors"
          >
            Start a project →
          </a>
        </div>

        <ul class="mt-10 flex items-center gap-3" aria-label="elefox studio on social media">
          <li>
            <a
              href="https://www.instagram.com/elefoxstudio/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="elefox studio on Instagram"
              class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-bone/20 text-bone/70 hover:text-bone hover:border-bone/50 transition-colors"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/company/elefoxstudio/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="elefox studio on LinkedIn"
              class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-bone/20 text-bone/70 hover:text-bone hover:border-bone/50 transition-colors"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.4h3.1V21H3.4V8.4Zm5.06 0h2.97v1.72h.04c.41-.78 1.43-1.6 2.94-1.6 3.15 0 3.73 2.07 3.73 4.76V21h-3.1v-5.6c0-1.34-.02-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H8.46V8.4Z"/>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.facebook.com/elefoxstudio/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="elefox studio on Facebook"
              class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-bone/20 text-bone/70 hover:text-bone hover:border-bone/50 transition-colors"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-8h2.4l.36-2.9H13.5V8.25c0-.84.24-1.41 1.44-1.41h1.53V4.25c-.27-.04-1.18-.12-2.24-.12-2.22 0-3.74 1.36-3.74 3.85V10.1H8.1V13h2.4v8h3Z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <nav
        class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-12"
        aria-label="Footer navigation"
      >
        {
          footerNav.map((group) => (
            <div>
              <h3 class="text-xs font-mono uppercase tracking-[0.14em] text-bone/50 mb-5">
                {group.heading}
              </h3>
              <ul class="space-y-3">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-bone/85 hover:text-bone transition-colors"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <hr class="rule rule--forest mt-20 opacity-30" />

    <div
      class="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm text-bone/55"
    >
      <p>
        © {year} elefox studio · Coral Springs, FL ·
        <a href="tel:+19547806508" class="hover:text-bone transition-colors">954.780.6508</a> ·
        <a href="mailto:hello@elefoxstudio.com" class="hover:text-bone transition-colors">hello@elefoxstudio.com</a>
      </p>
      <div class="flex items-center gap-5">
        <a href="/privacy" class="hover:text-bone transition-colors">Privacy</a>
        <span class="font-mono text-xs tracking-wider">elefoxstudio.com</span>
      </div>
    </div>
      </div>
    </div>
  </Container>
</footer>
