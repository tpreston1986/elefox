---
import Container from "./Container.astro";
import { footerNav } from "../data/nav";

const year = new Date().getFullYear();
---

<footer class="bg-ink text-bone">
  <Container size="wide" class="pt-24 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-5">
        <img
          src="/brand/logo-horizontal-white.png"
          alt="elefox studio"
          class="h-8 w-auto mb-6"
          width="180"
          height="40"
        />
        <p class="text-bone/70 text-lg leading-relaxed max-w-md">
          A design and product studio. We build the websites, internal tools,
          and quiet automations that small companies grow on.
        </p>

        <div class="mt-10 max-w-md">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 bg-bone text-ink font-medium rounded-pill hover:bg-cream transition-colors"
          >
            Start a project →
          </a>
        </div>
      </div>

      <nav
        class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-12"
        aria-label="Footer navigation"
      >
        {
          footerNav.map((group) => (
            <div>
              <h3 class="text-xs font-mono uppercase tracking-[0.14em] text-bone/50 mb-5">
                {group.heading}
              </h3>
              <ul class="space-y-3">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-bone/85 hover:text-bone transition-colors"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <hr class="rule rule--forest mt-20 opacity-30" />

    <div
      class="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm text-bone/55"
    >
      <p>
        © {year} elefox studio. Built in South Florida.
      </p>
      <p class="font-mono text-xs tracking-wider">
        elefoxstudio.com · v0.1
      </p>
    </div>
  </Container>
</footer>
