---
import Container from "./Container.astro";
import Button from "./Button.astro";
import { primaryNav } from "../data/nav";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-bone/85 backdrop-blur-md border-b border-fog/60">
  <Container size="wide" class="flex items-center justify-between h-16 md:h-20">
    <a
      href="/"
      class="flex items-center gap-2 group"
      aria-label="elefox studio, home"
    >
      <img
        src="/brand/logo-horizontal.png"
        alt="elefox studio"
        class="h-7 md:h-8 w-auto transition-opacity group-hover:opacity-80"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        width="790"
        height="100"
      />
    </a>

    <nav
      class="hidden md:flex items-center gap-1"
      aria-label="Primary navigation"
    >
      {
        primaryNav.map((item) => {
          const active =
            currentPath === item.href ||
            (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-4 py-2 text-sm font-medium tracking-tight rounded-pill transition-colors duration-150 ${
                active
                  ? "text-forest bg-forest-wash"
                  : "text-ink hover:text-forest hover:bg-forest-wash/60"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <a
        href="https://portal.elefoxstudio.com/login"
        class="hidden md:inline-flex text-sm font-medium text-graphite hover:text-forest transition-colors px-3 py-2"
      >
        Client portal
      </a>
      <div class="hidden md:block">
        <Button href="/contact" size="sm">Start a project</Button>
      </div>
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 -mr-2 text-ink hover:text-forest"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 7h16M3 11h16M3 15h16"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </Container>

  <!-- (mobile menu overlay lives outside the header; see below) -->
</header>

<!-- Full-screen mobile menu overlay. Must NOT live inside <header>: the
     header's backdrop-blur creates a containing block that would trap a
     position:fixed child and stop it covering the viewport. -->
<div
  id="mobile-menu"
  class="md:hidden fixed inset-0 z-50 bg-bone flex flex-col opacity-0 translate-y-2 pointer-events-none transition-[opacity,transform] duration-300 ease-[var(--ease-out-quint)]"
  aria-hidden="true"
>
    <div class="flex items-center justify-between h-16 px-6 border-b border-fog/60 flex-shrink-0">
      <a href="/" class="flex items-center" aria-label="elefox studio, home">
        <img
          src="/brand/logo-horizontal.png"
          alt="elefox studio"
          class="h-7 w-auto"
          width="790"
          height="100"
        />
      </a>
      <button
        id="mobile-menu-close"
        class="p-2 -mr-2 text-ink hover:text-forest transition-colors"
        aria-label="Close menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav
      class="flex-1 overflow-y-auto flex flex-col justify-center px-6 gap-1"
      aria-label="Mobile navigation"
    >
      {
        primaryNav.map((item) => {
          const active =
            currentPath === item.href ||
            (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`py-3 text-4xl font-display font-bold tracking-tight transition-colors ${
                active ? "text-forest" : "text-ink hover:text-forest"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href="https://portal.elefoxstudio.com/login"
        class="py-3 text-2xl font-display tracking-tight text-graphite hover:text-forest transition-colors mt-2"
      >
        Client portal
      </a>
    </nav>

    <div class="px-6 pb-10 pt-4 flex-shrink-0">
      <a
        href="/contact"
        class="block w-full px-6 py-4 text-center text-lg font-medium bg-forest text-bone rounded-pill hover:bg-forest-deep transition-colors"
      >
        Start a project →
      </a>
    </div>
  </div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const menu = document.getElementById("mobile-menu");

  const setMenu = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle("opacity-0", !open);
    menu.classList.toggle("translate-y-2", !open);
    menu.classList.toggle("pointer-events-none", !open);
    toggle.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-hidden", String(!open));
    document.documentElement.style.overflow = open ? "hidden" : "";
  };

  toggle?.addEventListener("click", () => setMenu(true));
  closeBtn?.addEventListener("click", () => setMenu(false));
  // Close when any link inside the menu is tapped.
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false)),
  );
  // Close on Escape.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
