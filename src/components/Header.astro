---
import Container from "./Container.astro";
import Button from "./Button.astro";
import { primaryNav } from "../data/nav";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-bone/85 backdrop-blur-md border-b border-fog/60">
  <Container size="wide" class="flex items-center justify-between h-16 md:h-20">
    <a
      href="/"
      class="flex items-center gap-2 group"
      aria-label="elefox studio, home"
    >
      <img
        src="/brand/logo-horizontal.png"
        alt="elefox studio"
        class="h-7 md:h-8 w-auto transition-opacity group-hover:opacity-80"
        width="180"
        height="40"
      />
    </a>

    <nav
      class="hidden md:flex items-center gap-1"
      aria-label="Primary navigation"
    >
      {
        primaryNav.map((item) => {
          const active =
            currentPath === item.href ||
            (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-4 py-2 text-sm font-medium tracking-tight rounded-pill transition-colors duration-150 ${
                active
                  ? "text-forest bg-forest-wash"
                  : "text-ink hover:text-forest hover:bg-forest-wash/60"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <a
        href="https://portal.elefoxstudio.com/login"
        class="hidden md:inline-flex text-sm font-medium text-graphite hover:text-forest transition-colors px-3 py-2"
      >
        Client portal
      </a>
      <div class="hidden md:block">
        <Button href="/contact" size="sm">Start a project</Button>
      </div>
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 -mr-2 text-ink hover:text-forest"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 7h16M3 11h16M3 15h16"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </Container>

  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-fog"
    aria-hidden="true"
  >
    <Container size="wide" class="py-4 flex flex-col gap-1">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class="px-4 py-3 text-base font-medium text-ink hover:text-forest hover:bg-forest-wash rounded-lg transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="https://portal.elefoxstudio.com/login"
        class="px-4 py-3 text-base font-medium text-graphite hover:text-forest hover:bg-forest-wash rounded-lg transition-colors"
      >
        Client portal
      </a>
      <a
        href="/contact"
        class="mt-3 px-4 py-3 text-center text-base font-medium bg-forest text-bone rounded-pill hover:bg-forest-deep transition-colors"
      >
        Start a project →
      </a>
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
    menu?.setAttribute("aria-hidden", String(isOpen));
  });
</script>
