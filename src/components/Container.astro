---
type Props = {
  as?: keyof HTMLElementTagNameMap;
  size?: "narrow" | "default" | "wide" | "full";
  class?: string;
  [key: string]: unknown;
};

const {
  as: Tag = "div",
  size = "default",
  class: className = "",
  ...rest
} = Astro.props;

const sizes: Record<"narrow" | "default" | "wide" | "full", string> = {
  narrow: "max-w-3xl",
  default: "max-w-6xl",
  wide: "max-w-7xl",
  full: "max-w-[1600px]",
};
---

<Tag class={`mx-auto w-full px-6 md:px-10 ${sizes[size]} ${className}`} {...rest}>
  <slot />
</Tag>
