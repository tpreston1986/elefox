---
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";
import Button from "./Button.astro";
import HeroAtmosphere from "./HeroAtmosphere.astro";

type Props = {
  index?: string;
  category: string;
  title: string;
  /** Substring of `title` to wrap in the animated gradient accent. */
  titleAccent?: string;
  description: string;
};

const { category, title, titleAccent, description } = Astro.props;

const accentIndex =
  titleAccent && title.includes(titleAccent) ? title.indexOf(titleAccent) : -1;
const before = accentIndex >= 0 ? title.slice(0, accentIndex) : title;
const after =
  accentIndex >= 0 ? title.slice(accentIndex + titleAccent!.length) : "";
---

<section
  data-glow
  class="relative overflow-hidden pt-24 md:pt-36 pb-16 md:pb-24"
>
  <HeroAtmosphere />

  <Container size="full" class="relative z-10 text-center">
    <div class="mb-12">
      <Eyebrow>{category}</Eyebrow>
    </div>

    <h1 data-split class="display-xl text-ink max-w-[16ch] mx-auto">
      {accentIndex >= 0 ? (
        <>
          {before}<span class="text-gradient-flow">{titleAccent}</span>{after}
        </>
      ) : (
        title
      )}
    </h1>

    <p class="lede mt-12 text-xl md:text-2xl max-w-3xl mx-auto text-center">
      {description}
    </p>

    <div class="mt-12 flex flex-wrap gap-4 justify-center">
      <Button href="/contact" size="lg" class="btn-magnetic">Start a project</Button>
      <Button href="/contact#book" variant="secondary" size="lg" class="btn-magnetic">Book a call</Button>
    </div>
  </Container>
</section>
