---
// Service page header: the shared calm PageHeader with a breadcrumb back to
// the services index and the two project CTAs.
import PageHeader from "./PageHeader.astro";
import Button from "./Button.astro";

type Props = {
  index?: string;
  category: string;
  title: string;
  /** Substring of `title` to set in the accent colour. */
  titleAccent?: string;
  description: string;
};

const { category, title, titleAccent, description } = Astro.props;
---

<PageHeader
  title={title}
  accent={titleAccent}
  lede={description}
  crumbs={[{ label: "What we do", href: "/services" }, { label: category }]}
>
  <div class="mt-8 flex flex-wrap gap-3">
    <Button href="/contact" size="lg">Start a project</Button>
    <Button href="/contact#book" variant="secondary" size="lg">Book a call</Button>
  </div>
</PageHeader>
