---
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";

type Props = {
  good: string[];
  skip: string[];
};

const { good, skip } = Astro.props;
---

<section class="py-20 md:py-32">
  <Container size="full">
    <Eyebrow>Honest check</Eyebrow>
    <h2 class="mt-6 mb-16 md:mb-20 max-w-3xl">
      Is this a fit?
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
      <div class="border-l-2 border-forest pl-8 md:pl-10 py-2">
        <h3 class="text-lg font-mono uppercase tracking-wider text-forest mb-6">
          → Good fit if
        </h3>
        <ul class="space-y-5">
          {
            good.map((g) => (
              <li class="text-lg md:text-xl text-ink leading-snug">{g}</li>
            ))
          }
        </ul>
      </div>

      <div class="border-l-2 border-mist pl-8 md:pl-10 py-2">
        <h3 class="text-lg font-mono uppercase tracking-wider text-graphite mb-6">
          → Skip if
        </h3>
        <ul class="space-y-5">
          {
            skip.map((s) => (
              <li class="text-lg md:text-xl text-graphite leading-snug">
                {s}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
