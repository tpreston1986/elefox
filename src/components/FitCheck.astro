---
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";

type Props = {
  good: string[];
  skip: string[];
};

const { good, skip } = Astro.props;
---

<section class="py-20 md:py-32">
  <Container size="full">
    <div data-reveal>
      <Eyebrow>Honest check</Eyebrow>
      <h2 class="mt-6 mb-16 md:mb-20 max-w-3xl">
        Is this a fit?
      </h2>
    </div>

    <div data-reveal-stagger class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      <div class="rounded-2xl border border-forest/25 bg-forest-wash p-8 md:p-10">
        <h3 class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.14em] text-forest mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-forest"></span>
          Good fit if
        </h3>
        <ul class="space-y-5">
          {
            good.map((g) => (
              <li class="text-lg md:text-xl text-ink leading-snug">{g}</li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-fog bg-white p-8 md:p-10">
        <h3 class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.14em] text-graphite mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-mist"></span>
          Skip if
        </h3>
        <ul class="space-y-5">
          {
            skip.map((s) => (
              <li class="text-lg md:text-xl text-graphite leading-snug">
                {s}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
