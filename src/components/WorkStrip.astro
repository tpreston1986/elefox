---
// A row of work cards: three across on desktop (middle one dropped a step),
// a swipe row below lg. With fewer than three projects, the last slot links
// to the full /work index instead of leaving a hole in the grid.
import WorkCard from "./WorkCard.astro";
import type { Project } from "../data/work";

interface Props {
  projects: Project[];
  headingLevel?: "h2" | "h3";
}

const { projects, headingLevel = "h3" } = Astro.props;
const shown = projects.slice(0, 3);
const fill = shown.length < 3;
---

<div class="mx-auto w-full max-w-[1600px] lg:px-10">
  <div
    data-reveal-stagger
    class="work-strip flex lg:grid lg:grid-cols-3 gap-5 md:gap-8 overflow-x-auto lg:overflow-visible snap-x snap-mandatory px-6 md:px-10 lg:px-0 pb-2"
  >
    {
      shown.map((p, i) => (
        <div class="shrink-0 w-[84%] sm:w-[62%] md:w-[46%] lg:w-auto snap-start">
          <div class:list={["h-full", i === 1 && shown.length === 3 && "lg:translate-y-[4.5rem]"]}>
            <WorkCard project={p} headingLevel={headingLevel} />
          </div>
        </div>
      ))
    }
    {
      fill && (
        <div class="shrink-0 w-[84%] sm:w-[62%] md:w-[46%] lg:w-auto snap-start">
          <a
            href="/work"
            class="group h-full min-h-[260px] flex flex-col justify-end rounded-[24px] border border-mist p-7 md:p-8 text-ink hover:border-forest transition-colors"
          >
            <span class="font-display font-bold text-2xl md:text-[1.75rem] tracking-[-0.02em] leading-tight">
              See everything we've built
            </span>
            <span class="mt-4 inline-flex items-center gap-2 text-forest font-medium group-hover:gap-3 transition-all">
              All work
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h11m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  .work-strip {
    scroll-padding-inline: 1.5rem;
    scrollbar-width: none;
  }
  .work-strip::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    .work-strip {
      scroll-padding-inline: 2.5rem;
    }
  }
</style>
