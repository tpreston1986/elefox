---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import HeroAtmosphere from "../components/HeroAtmosphere.astro";

const calendlyUrl =
  import.meta.env.CALENDLY_URL ||
  "https://calendly.com/contact-tiffanyrussell/discovery-call";

const services = [
  { value: "crm", label: "Custom CRM" },
  { value: "software", label: "Custom software" },
  { value: "websites", label: "Websites" },
  { value: "brand", label: "Brand & marketing" },
  { value: "ai", label: "AI & automation" },
  { value: "other", label: "Not sure yet" },
];

const budgets = [
  "Under $2k",
  "$2k – $5k",
  "$5k – $10k",
  "$10k+",
  "Not sure",
];

const timelines = ["ASAP / this month", "1–3 months", "3–6 months", "Flexible"];

const preselected = Astro.url.searchParams.get("service") || "";

// Cloudflare Turnstile (bot protection). When the public site key is set, the
// widget renders and the server verifies the token. Falls back gracefully
// (no widget, server skips verification) when unset, e.g. local dev.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<BaseLayout
  title="Start a project"
  description="Tell us what you're building. We'll get back within 24 hours."
>
  <!-- Hero -->
  <section data-glow class="relative overflow-hidden pt-24 md:pt-36 pb-16">
    <HeroAtmosphere />
    <Container size="full" class="relative z-10 text-center">
      <Eyebrow>Start a project</Eyebrow>
      <h1 data-split class="display-xl mt-6 max-w-[18ch] mx-auto">
        Tell us what you're
        <span class="text-gradient-flow">building</span>.
      </h1>
      <p class="lede mt-10 text-xl max-w-3xl mx-auto text-center">
        Fill this out, send us a note, or book a call. We respond within
        24 hours, most of the time within four.
      </p>
    </Container>
  </section>

  <!-- Form -->
  <section class="pb-24 md:pb-32">
    <Container size="default" data-reveal>
      <form
        action="/api/contact"
        method="post"
        novalidate
        class="space-y-10 bg-white border border-fog rounded-2xl p-8 md:p-12"
        id="contact-form"
      >
        <input type="hidden" name="_t" value={Date.now()} />
        <div class="absolute -left-[9999px]">
          <label>
            Website
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <!-- Step: services -->
        <fieldset>
          <legend class="text-xl text-ink font-display mb-5 tracking-tight">
            What do you need?
          </legend>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            {
              services.map((s) => (
                <label class="cursor-pointer">
                  <input
                    type="checkbox"
                    name="services"
                    value={s.value}
                    checked={preselected === s.value}
                    class="peer sr-only"
                  />
                  <span class="block px-4 py-3 text-center border border-fog rounded-pill text-sm font-medium text-ink hover:border-forest peer-checked:bg-forest peer-checked:text-bone peer-checked:border-forest transition-all">
                    {s.label}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- Step: business -->
        <fieldset>
          <legend class="text-xl text-ink font-display mb-5 tracking-tight">
            About your business
          </legend>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <label class="block">
              <span class="block text-sm font-medium text-graphite mb-2">Business name</span>
              <input
                type="text"
                name="business_name"
                class="w-full bg-bone border border-fog hover:border-mist focus:border-forest text-ink px-4 py-3 rounded-lg outline-none transition-colors"
              />
            </label>
            <label class="block">
              <span class="block text-sm font-medium text-graphite mb-2">Industry</span>
              <input
                type="text"
                name="industry"
                class="w-full bg-bone border border-fog hover:border-mist focus:border-forest text-ink px-4 py-3 rounded-lg outline-none transition-colors"
              />
            </label>
            <label class="block md:col-span-2">
              <span class="block text-sm font-medium text-graphite mb-2">One-sentence description</span>
              <input
                type="text"
                name="description"
                placeholder="e.g., a therapy practice in Boca Raton serving teens and families"
                class="w-full bg-bone border border-fog hover:border-mist focus:border-forest text-ink px-4 py-3 rounded-lg outline-none transition-colors"
              />
            </label>
          </div>
        </fieldset>

        <!-- Step: budget + timeline -->
        <fieldset>
          <legend class="text-xl text-ink font-display mb-5 tracking-tight">
            Budget & timeline
          </legend>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <span class="block text-sm font-medium text-graphite mb-3">Budget range</span>
              <div class="space-y-2">
                {
                  budgets.map((b) => (
                    <label class="flex items-center gap-3 cursor-pointer group">
                      <input type="radio" name="budget" value={b} class="peer sr-only" />
                      <span class="w-4 h-4 rounded-full border border-mist peer-checked:border-forest peer-checked:bg-forest transition-all flex-shrink-0" />
                      <span class="text-ink group-hover:text-forest transition-colors">{b}</span>
                    </label>
                  ))
                }
              </div>
            </div>
            <div>
              <span class="block text-sm font-medium text-graphite mb-3">Timeline</span>
              <div class="space-y-2">
                {
                  timelines.map((t) => (
                    <label class="flex items-center gap-3 cursor-pointer group">
                      <input type="radio" name="timeline" value={t} class="peer sr-only" />
                      <span class="w-4 h-4 rounded-full border border-mist peer-checked:border-forest peer-checked:bg-forest transition-all flex-shrink-0" />
                      <span class="text-ink group-hover:text-forest transition-colors">{t}</span>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>
        </fieldset>

        <!-- Step: contact -->
        <fieldset>
          <legend class="text-xl text-ink font-display mb-5 tracking-tight">
            How do we reach you?
          </legend>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <label class="block">
              <span class="block text-sm font-medium text-graphite mb-2">Name <span class="text-ember">*</span></span>
              <input
                type="text"
                name="name"
                required
                class="w-full bg-bone border border-fog hover:border-mist focus:border-forest text-ink px-4 py-3 rounded-lg outline-none transition-colors"
              />
            </label>
            <label class="block">
              <span class="block text-sm font-medium text-graphite mb-2">Email <span class="text-ember">*</span></span>
              <input
                type="email"
                name="email"
                required
                class="w-full bg-bone border border-fog hover:border-mist focus:border-forest text-ink px-4 py-3 rounded-lg outline-none transition-colors"
              />
            </label>
            <label class="block md:col-span-2">
              <span class="block text-sm font-medium text-graphite mb-2">Anything else we should know?</span>
              <textarea
                name="message"
                rows="4"
                class="w-full bg-bone border border-fog hover:border-mist focus:border-forest text-ink px-4 py-3 rounded-lg outline-none transition-colors resize-y"
              ></textarea>
            </label>
          </div>
        </fieldset>

        {
          turnstileSiteKey && (
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="light"
              data-size="flexible"
              data-refresh-expired="auto"
              data-refresh-timeout="auto"
            />
          )
        }

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-4 border-t border-fog">
          <p class="text-sm text-graphite">
            We'll get back to you within 24 hours.
          </p>
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-forest text-bone rounded-pill text-lg font-medium hover:bg-forest-deep transition-colors disabled:opacity-50"
          >
            Send it →
          </button>
        </div>
      </form>

      {
        turnstileSiteKey && (
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          />
        )
      }

      <script is:inline>
        (() => {
          const form = document.getElementById("contact-form");
          if (!form) return;

          const showError = (field, msg) => {
            field.setAttribute("aria-invalid", "true");
            field.classList.add("ring-2", "ring-ember", "border-ember");
            const wrap = field.closest("label") || field.parentElement;
            const span = document.createElement("span");
            span.dataset.error = "";
            span.className = "block mt-2 text-sm font-medium text-ember";
            span.textContent = msg;
            wrap.appendChild(span);
          };

          const clearErrors = () => {
            form.querySelectorAll("[data-error]").forEach((el) => el.remove());
            form.querySelectorAll("[aria-invalid]").forEach((el) => {
              el.removeAttribute("aria-invalid");
              el.classList.remove("ring-2", "ring-ember", "border-ember");
            });
          };

          const isEmail = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());

          const submitBtn = form.querySelector('button[type="submit"]');

          // Turnstile can take a few seconds to issue its token. If the visitor
          // submits before it lands, wait for it rather than failing the send.
          const hasTurnstile = !!form.querySelector(".cf-turnstile");
          const tokenValue = () => {
            const f = form.querySelector('[name="cf-turnstile-response"]');
            return f ? f.value : "";
          };
          const waitForToken = (ms = 12000) =>
            new Promise((resolve) => {
              if (!hasTurnstile || tokenValue()) return resolve(true);
              let waited = 0;
              const iv = setInterval(() => {
                if (tokenValue()) { clearInterval(iv); resolve(true); }
                else if ((waited += 300) >= ms) { clearInterval(iv); resolve(false); }
              }, 300);
            });

          form.addEventListener("submit", async (e) => {
            e.preventDefault();
            clearErrors();

            const name = form.querySelector('input[name="name"]');
            const email = form.querySelector('input[name="email"]');
            const errors = [];

            if (!name.value.trim()) {
              errors.push([name, "First, what should we call you?"]);
            }
            if (!email.value.trim()) {
              errors.push([email, "We'll need somewhere to write back."]);
            } else if (!isEmail(email.value)) {
              errors.push([email, "Hmm, that doesn't look like an email."]);
            }

            if (errors.length) {
              errors.forEach(([f, m]) => showError(f, m));
              errors[0][0].focus();
              errors[0][0].scrollIntoView({ behavior: "smooth", block: "center" });
              return;
            }

            const cleanName = name.value.trim().replace(/[<>]/g, "");

            // Submit to the live endpoint.
            const originalLabel = submitBtn.innerHTML;
            submitBtn.disabled = true;

            // Wait for the Turnstile token if it hasn't landed yet.
            if (hasTurnstile && !tokenValue()) {
              submitBtn.innerHTML = "Verifying…";
              const ready = await waitForToken();
              if (!ready) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalLabel;
                if (window.turnstile) { try { window.turnstile.reset(); } catch (_) {} }
                const b = document.createElement("p");
                b.dataset.error = "";
                b.className = "text-sm font-medium text-ember mt-3";
                b.textContent = "Verification is taking a moment. Tap send again, or email hello@elefoxstudio.com.";
                submitBtn.parentElement.appendChild(b);
                return;
              }
            }

            submitBtn.innerHTML = "Sending…";

            const post = async () => {
              const res = await fetch("/api/contact", {
                method: "POST",
                body: new FormData(form),
              });
              const data = await res.json().catch(() => ({}));
              return { ok: res.ok && data.ok, status: res.status, error: data.error };
            };

            try {
              let r = await post();
              // 403 = stale/expired Turnstile token (widget still shows
              // "Success" but the token died). Force a fresh one, retry once.
              if (!r.ok && r.status === 403 && hasTurnstile) {
                submitBtn.innerHTML = "Verifying…";
                const tf = form.querySelector('[name="cf-turnstile-response"]');
                if (tf) tf.value = "";
                if (window.turnstile) { try { window.turnstile.reset(); } catch (_) {} }
                if (await waitForToken()) {
                  submitBtn.innerHTML = "Sending…";
                  r = await post();
                }
              }
              if (!r.ok) throw new Error(r.error || "Something went wrong.");
            } catch (err) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalLabel;
              // Turnstile tokens are single-use; reset so a retry gets a fresh one.
              if (window.turnstile) {
                try { window.turnstile.reset(); } catch (_) {}
              }
              const msg =
                (err && err.message) ||
                "Something went wrong. Email hello@elefoxstudio.com directly?";
              const banner = document.createElement("p");
              banner.dataset.error = "";
              banner.className = "text-sm font-medium text-ember mt-3";
              banner.textContent = msg;
              submitBtn.parentElement.appendChild(banner);
              return;
            }

            // Fire the GA4 lead conversion.
            if (typeof window.gtag === "function") {
              window.gtag("event", "generate_lead", { source: "contact-form", form: "contact" });
            }

            const sent = document.createElement("div");
            sent.className = "text-center py-16 md:py-24";
            sent.innerHTML = `
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-ember inline-block mb-5">Got it</span>
              <h2 class="display-xl text-ink mt-2 mb-6">Thanks, ${cleanName}.</h2>
              <p class="lede text-xl text-graphite max-w-2xl mx-auto">
                We'll write you back within 24 hours, most of the time within four.
                In the meantime: we know we owe you a real response, not a thank-you template.
              </p>
            `;
            form.replaceWith(sent);
            sent.scrollIntoView({ behavior: "smooth", block: "start" });
          });

          // Clear an individual field's error as the user fixes it
          form.querySelectorAll("input, textarea").forEach((input) => {
            input.addEventListener("input", () => {
              if (input.getAttribute("aria-invalid") === "true") {
                input.removeAttribute("aria-invalid");
                input.classList.remove("ring-2", "ring-ember", "border-ember");
                const wrap = input.closest("label") || input.parentElement;
                const err = wrap.querySelector("[data-error]");
                if (err) err.remove();
              }
            });
          });
        })();
      </script>

      <!-- Book a call -->
      <div id="book" class="mt-16 md:mt-24 text-center">
        <Eyebrow>Or just talk</Eyebrow>
        <h2 class="mt-6 mb-6">Rather book a call?</h2>
        <p class="lede mx-auto mb-10">
          A 30-minute discovery call, free, no pitch deck, just a real
          conversation about what you're trying to build.
        </p>
        <Button href={calendlyUrl} variant="primary" size="lg" external>
          Book a discovery call
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
