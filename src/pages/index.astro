---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import HeroAtmosphere from "../components/HeroAtmosphere.astro";
import WorkStrip from "../components/WorkStrip.astro";
import ArtContours from "../components/art/ArtContours.astro";
import WorkStage from "../components/WorkStage.astro";
import Doodle, { type DoodleName } from "../components/Doodle.astro";
import { featuredProjects, getProject, toneStyles, type Brand, type Thumb } from "../data/work";
import { menuServices } from "../data/services";
import Testimonials from "../components/Testimonials.astro";
import { getTestimonials } from "../lib/testimonials";

// "What we do": the same services as the nav, each shown with a real build
// when there is one. A service without an example renders without a panel.
// None of these repeat the three in the Selected work strip above.
type Example = { name: string; note: string; href?: string; brand: Brand; thumb: Thumb };
const fromWork = (slug: string, note: string): Example => {
  const p = getProject(slug)!;
  return { name: p.name, note, href: `/work/${p.slug}`, brand: p.brand, thumb: p.thumb };
};
const examples: Partial<Record<string, Example>> = {
  websites: fromWork("chenoa-mcgee-design", "Client website"),
  mobile: fromWork("cove", "Our own game, on the App Store and Google Play"),
  software: fromWork("client-portal", "The portal we run the studio on"),
  brand: fromWork("rkg-therapy", "Client brand and website"),
};

const exploreLabel: Record<string, string> = {
  websites: "Explore web development",
  mobile: "Explore mobile development",
  software: "Explore custom software",
  brand: "Explore branding",
  "early-stage": "Explore early-stage builds",
};

const processSteps = [
  {
    title: "Discover",
    kind: "discover",
    body: "A free 30-minute discovery call. We learn how your business runs, what you're using now, and where things keep getting stuck. You leave with notes and next steps either way.",
  },
  {
    title: "Plan",
    kind: "plan",
    body: "A written plan with the price and the timeline spelled out. Fixed fee where we can, a clear range where we can't.",
  },
  {
    title: "Build",
    kind: "build",
    body: "We build in short cycles, so you see progress every week instead of one big reveal at the end. Two rounds of revisions are included.",
  },
  {
    title: "Launch",
    kind: "launch",
    body: "We handle the boring parts: DNS, analytics, monitoring, and training your team. You handle the celebrating.",
  },
  {
    title: "Operate",
    kind: "operate",
    body: "Most clients stay on a small retainer. Hosting, backups, the occasional new feature. Like having a developer on call, without the hire.",
  },
];

// Small uptime bars for the Operate phase mockup.
const uptimeBars = [60, 80, 50, 90, 70, 100, 85, 95, 65, 88, 75, 92];

const faqs = [
  {
    q: "How long does a build take?",
    a: "A custom app or platform is typically a few weeks to a couple of months. Smaller sites and tools are faster. Either way, the timeline is written into the plan before we start, not a vague range that drifts.",
  },
  {
    q: "Do I own what you build?",
    a: "Yes. The build and your data belong to you. We host it and keep it running, but you can pack it up and take it anywhere. Nobody's holding your business hostage.",
  },
  {
    q: "What does it cost?",
    a: "Most engagements are fixed-fee: half to start, half on delivery, two rounds of revisions baked in. Custom work runs in transparent ranges. Full numbers live on the pricing page.",
  },
  {
    q: "I already have a website. Can you work with it?",
    a: "Usually, yes. We build the tools and wire them into your existing site. If the site itself is holding you back, we'll say so and rebuild it.",
  },
  {
    q: "What can you build?",
    a: "Websites, mobile apps, and custom software (CRMs, client portals, booking systems, internal dashboards). We can do the brand and marketing too, if you'd like it all in one place.",
  },
  {
    q: "What happens after launch?",
    a: "We stick around. Most clients stay on a small retainer for hosting, backups, and the occasional new feature, so there's always someone who knows your build inside and out.",
  },
  {
    q: "Will you actually take my project?",
    a: "Maybe! We keep our software client list small on purpose, so every build gets real attention. If we're not the right fit, you'll hear it on the first call, not three weeks in.",
  },
];

// Approved client quotes from the portal; empty hides the section.
const testimonials = await getTestimonials();
---

<BaseLayout
  title="Web, App & Software Development for Small Business · elefox studio"
  description="Web, mobile, and custom software development for small business. The sites, apps, and software your business runs on, built around how you work. We host it, you own it."
>
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Hero                                                                 -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="pt-2 md:pt-4">
    <Container size="full">
      <div
        id="hero"
        data-glow
        class="relative isolate overflow-hidden rounded-[28px] md:rounded-[44px] min-h-[82vh] flex flex-col justify-center pt-28 md:pt-36 pb-20 md:pb-24 px-6 md:px-12 bg-gradient-to-b from-[#FBF1E9] via-[#F8ECE0] to-[#F2E2D2]"
      >
        <HeroAtmosphere warm />
        <ArtContours
          seed="hero"
          width={1440}
          height={780}
          at={[0.5, 0.5]}
          size={[0.4, 0.34]}
          angle={-6}
          strength={0.16}
          fade="radial-gradient(ellipse 90% 85% at 50% 50%, #000 55%, transparent 100%)"
        />

        <div class="relative z-10 text-center max-w-5xl mx-auto">
          <h1 data-split class="font-display font-extrabold tracking-[-0.04em] leading-[0.92] text-[clamp(2.5rem,7vw,6rem)] text-ink max-w-[20ch] mx-auto">
            The websites, apps, and software
            <span class="relative inline-block">
              <em class="not-italic text-gradient-flow">your business</em>
              <svg viewBox="0 0 260 14" class="absolute left-0 -bottom-2 md:-bottom-3 w-full h-3 text-ember underline-draw" aria-hidden="true" preserveAspectRatio="none">
                <path d="M2 8 Q 40 2, 80 7 T 160 8 T 220 6 T 258 7" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
            runs on.
          </h1>

          <p class="lede mx-auto mt-10 md:mt-12 text-xl md:text-2xl text-graphite text-center">
            Off-the-shelf software makes you bend your business to fit it. We
            go the other way: sites, apps, and custom software built around how
            you already work. We host it, you own it. And if you want the brand
            and marketing in the same place, we do that too.
          </p>
          <div class="mt-10 flex flex-wrap gap-4 justify-center">
            <Button href="/services" size="lg" class="btn-magnetic">See what we do</Button>
            <Button href="/contact" variant="secondary" size="lg" class="btn-magnetic">Start a project</Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Selected work, three live builds as work cards. Three across on     -->
  <!-- desktop with the middle one dropped, a swipe row below that.         -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="pt-20 md:pt-32 pb-4 lg:pb-20" id="work">
    <Container size="full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 mb-12 md:mb-16">
        <div class="lg:col-span-5">
          <h2 data-split>A few things we've built lately.</h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 self-end">
          <p class="lede">
            A laundry service that books and bills itself. Booking software
            for tattoo artists. A payroll expert's site he runs without a
            developer. All three are live.
          </p>
          <a
            href="/work"
            class="group inline-flex items-center gap-2 mt-7 text-forest font-medium hover:gap-3 transition-all"
          >
            See all our work
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h11m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </Container>

    <WorkStrip projects={featuredProjects} />
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Statement, single big centered line (Munch cadence)                  -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="relative isolate pt-24 pb-16 md:pt-36 md:pb-28">
    <ArtContours
      seed="one-studio"
      width={1440}
      height={560}
      at={[0.5, 0.5]}
      size={[0.37, 0.3]}
      angle={-5}
      strength={0.26}
      fade="radial-gradient(ellipse 62% 58% at 50% 50%, #000 55%, transparent 100%)"
    />
    <Container size="default">
      <h2 data-split class="text-center font-display font-extrabold tracking-[-0.03em] leading-[1.02] text-[clamp(2.25rem,6vw,5rem)] text-ink max-w-[22ch] mx-auto">
        One studio instead of
        <span class="text-ember">five vendors</span>
        who never talk to each other.
      </h2>
    </Container>
    <Container size="full">
    </Container>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- What we do: the six services from data/services.ts, each beside a    -->
  <!-- real build that links to its case study.                             -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="pb-8 md:pb-12 relative" id="capabilities">
    <Container size="full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-10 md:mb-14">
        <div class="lg:col-span-5">
          <h2 data-split>Development, end to end.</h2>
        </div>
        <p class="lg:col-span-6 lg:col-start-7 lede self-end">
          It starts with the software: a web app, a customer portal, the CRM
          or booking system behind the scenes. Then we build (or rebuild) the
          website that plugs into it. Brand and marketing are there too, if
          you want them.
        </p>
      </div>

      <div class="border-t border-fog">
        {
          menuServices.map((s) => {
            const ex = examples[s.slug];
            const tone = ex ? toneStyles(ex.brand.tone) : undefined;
            const Panel = ex?.href ? "a" : "div";
            return (
              <div data-reveal class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center py-10 md:py-14 border-b border-fog">
                <div class="lg:col-span-6">
                  <Doodle name={s.slug as DoodleName} class="w-24 h-24 md:w-28 md:h-28 -ml-3 mb-4" />
                  <h3 class="text-3xl md:text-[2.75rem] text-ink font-display tracking-tight leading-[1.02]">
                    {s.name}.
                  </h3>
                  <p class="text-graphite text-lg leading-relaxed max-w-lg mt-4">
                    {s.oneLiner}
                  </p>
                  <a
                    href={`/services/${s.slug}`}
                    class="group inline-flex items-center gap-2 mt-6 text-forest font-medium hover:gap-3 transition-all"
                  >
                    {exploreLabel[s.slug]}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M2 8h11m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </div>
                {ex && tone && (
                  <figure class="lg:col-span-5 lg:col-start-8">
                    <Panel
                      href={ex.href}
                      class:list={["cap-panel ws-host block rounded-[20px] overflow-hidden", tone.text]}
                      style={`--field:${ex.brand.field};--glow:${ex.brand.glow}`}
                      aria-label={ex.href ? `${ex.name} case study` : undefined}
                    >
                      <WorkStage thumb={ex.thumb} ratio="16 / 10" />
                    </Panel>
                    <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
                      <span class="text-ink font-medium">{ex.name}</span>
                      <span class="text-graphite">{ex.note}</span>
                    </figcaption>
                  </figure>
                )}
              </div>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Featured product, Custom CRM, as an inset rounded card              -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-6 md:py-10">
    <Container size="full">
      <div class="bg-forest-wash rounded-[28px] md:rounded-[40px] px-6 md:px-16 py-16 md:py-24 relative overflow-hidden">
        <div data-reveal class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          <div class="lg:col-span-6 order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-6">
              <span class="font-mono text-xs text-forest tracking-[0.14em] uppercase">Featured build</span>
              <span class="text-mist">·</span>
              <span class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.14em] text-ember">
                <span class="w-1.5 h-1.5 rounded-full bg-ember"></span>
                Live in production
              </span>
            </div>

            <h2 data-split class="mt-2 max-w-[16ch]">
              Custom software, built for how you run.
            </h2>

            <p class="lede mt-8 text-xl">
              For when nothing off the shelf fits how you work: a CRM, a client
              portal, a booking system, an internal dashboard. It uses your
              fields and your words. We host it, and it belongs to you. We run
              our own studio on the software we build.
            </p>

            <p class="mt-7 text-xl md:text-2xl font-display tracking-tight text-forest max-w-[26ch]">
              Priced for a small business, not a Fortune 500.
            </p>

            <div class="mt-10 flex flex-wrap gap-3">
              {["CRMs", "Client portals", "Booking systems", "Dashboards", "Hosted by us"].map((t) => (
                <span class="text-xs font-mono text-forest bg-bone border border-forest/20 px-3 py-1.5 rounded-pill">
                  {t}
                </span>
              ))}
            </div>

            <div class="mt-12 flex flex-wrap gap-4">
              <a
                href="/services/software"
                class="inline-flex items-center gap-2 px-6 py-3 bg-forest text-bone rounded-pill font-medium hover:bg-forest-deep transition-colors"
              >
                How we build software
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a
                href="/contact?service=software"
                class="inline-flex items-center gap-2 px-6 py-3 bg-transparent text-forest border-2 border-forest/40 rounded-pill font-medium hover:bg-forest hover:text-bone transition-colors"
              >
                Talk to us about yours
              </a>
            </div>
          </div>

          <div class="lg:col-span-6 order-1 lg:order-2 relative">
            {/* Product walkthrough */}
            <div class="relative rounded-xl overflow-hidden shadow-lift bg-ink group">
              <video
                id="portal-demo"
                src="/video/portal-overview.mp4"
                poster="/video/portal-poster.jpg"
                playsinline
                preload="metadata"
                aria-label="Client portal walkthrough: project management, contracts, and billing"
                class="block w-full h-auto"
              ></video>
              <button
                type="button"
                id="portal-demo-play"
                aria-label="Play client portal walkthrough"
                class="absolute inset-0 flex items-center justify-center bg-ink/20 hover:bg-ink/10 transition-colors"
              >
                <span class="flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-bone/95 text-forest shadow-lift group-hover:scale-105 transition-transform">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="ml-1">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </Container>

    <script is:inline>
      (() => {
        const video = document.getElementById("portal-demo");
        const btn = document.getElementById("portal-demo-play");
        if (!video || !btn) return;
        btn.addEventListener("click", () => {
          video.setAttribute("controls", "");
          btn.remove();
          video.play().catch(() => {});
        });
      })();
    </script>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- How we work, the five phases as a scroll-draw timeline              -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-20 md:py-32 relative">
    <Container size="full">
      <div class="max-w-5xl mx-auto">
        <div class="mb-16 md:mb-24 max-w-2xl">
          <h2 data-split>
            Small studio, grown-up process.
          </h2>
          <p class="lede mt-6">
            Every project follows the same five steps, so you always know where
            things stand. No surprise invoices, and no chasing us for an update.
          </p>
        </div>

        <div data-timeline class="timeline relative">
        {/* Vertical spine: left on mobile, centered on desktop. The ember
            fill height + head dot track scroll progress (--draw, set by JS). */}
        <div class="timeline__spine left-[10px] md:left-1/2 md:-translate-x-1/2" aria-hidden="true">
          <div class="timeline__fill"></div>
          <div class="timeline__head"></div>
        </div>

        <ol class="space-y-12 md:space-y-0">
          {
            processSteps.map((step) => (
              <li
                data-reveal
                class="relative pl-9 md:pl-0 md:grid md:grid-cols-2 md:gap-16 md:items-center md:py-10"
              >
                {/* Node dot, on the centre spine */}
                <span
                  class="absolute left-[10px] top-1.5 md:top-1/2 md:left-1/2 -translate-x-1/2 md:-translate-y-1/2 w-3.5 h-3.5 rounded-full bg-bone border-2 border-ember z-10"
                  aria-hidden="true"
                />

                {/* Text, always left */}
                <div class="md:col-start-1 md:pr-8">
                  <h3 class="text-2xl md:text-4xl text-ink font-display tracking-tight">
                    {step.title}.
                  </h3>
                  <p class="text-graphite leading-relaxed mt-3 max-w-md">
                    {step.body}
                  </p>
                </div>

                {/* Mockup, always right (desktop only) */}
                <div class="hidden md:flex md:col-start-2 md:justify-start">
                  <div class={`timeline-mock tl-${step.kind} w-full max-w-[440px] rounded-xl bg-white border border-fog shadow-soft p-5`}>
                    {step.kind === "discover" && (
                      <>
                        <span class="text-[10px] font-mono uppercase tracking-[0.12em] text-graphite/50">Discovery call</span>
                        <div class="mt-3 space-y-2">
                          <p class="text-[12.5px] bg-bone rounded-2xl rounded-tl-sm px-3 py-2 w-fit max-w-[88%] text-graphite">Where does the day actually go?</p>
                          <p class="tl-chat text-[12.5px] bg-forest text-bone rounded-2xl rounded-br-sm px-3 py-2 w-fit max-w-[88%] ml-auto">Re-typing the same client info, everywhere.</p>
                        </div>
                      </>
                    )}
                    {step.kind === "plan" && (
                      <>
                        <div class="flex items-center justify-between">
                          <span class="text-[10px] font-mono uppercase tracking-[0.12em] text-graphite/50">The plan</span>
                          <span class="text-[10px] font-mono text-forest">Fixed fee</span>
                        </div>
                        <ul class="mt-3 space-y-2 text-[12px]">
