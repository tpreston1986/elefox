  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduce) {
      // Loops run continuously. (In-view gating via ScrollTrigger play/pause
      // was freezing tweens mid-flight; these are small and few, so we just
      // let them run. The whole block is already gated by reduced-motion.)
      const loopInView = (_trigger: Element, tl: gsap.core.Timeline) => {
        tl.play();
      };
      const q = <T extends Element = HTMLElement>(s: string) =>
        Array.from(document.querySelectorAll<T>(s));

      // CRM: a soft highlight wave runs down the deal cards.
      q<HTMLElement>(".composite.crm").forEach((node) => {
        const deals = node.querySelectorAll(".crm-deal");
        if (!deals.length) return;
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.7 });
        tl.to(deals, {
          y: -3,
          scale: 1.03,
          duration: 0.45,
          ease: "sine.inOut",
          stagger: { each: 0.4, repeat: 1, yoyo: true },
        });
        loopInView(node, tl);
      });

      // Website: cursor drifts to the CTA, clicks, fades out, repeats.
      q<HTMLElement>(".composite.website").forEach((node) => {
        const cursor = node.querySelector<HTMLElement>(".site-cursor");
        const cta = node.querySelector<HTMLElement>(".site-cta");
        if (!cursor || !cta) return;
        const target = () => {
          // Measure relative to the cursor's own offset parent (the inner
          // page-content div, below the browser chrome) so the pointer tip
          // lands on the CTA rather than one chrome-height too low.
          const parent = (cursor.offsetParent as HTMLElement) || node;
          const pb = parent.getBoundingClientRect();
          const cb = cta.getBoundingClientRect();
          return {
            x: cb.left - pb.left + cb.width / 2 - 2,
            y: cb.top - pb.top + cb.height / 2 - 2,
          };
        };
        gsap.set(cursor, { x: 36, y: 168, autoAlpha: 0 });
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.1, repeatRefresh: true });
        tl.set(cursor, { x: 36, y: 168, autoAlpha: 0 })
          .to(cursor, { autoAlpha: 1, duration: 0.3 })
          .to(cursor, { duration: 1.05, ease: "power2.inOut", x: () => target().x, y: () => target().y })
          .to(cta, { scale: 0.9, duration: 0.12, ease: "power2.in" }, "-=0.05")
          .to(cta, { scale: 1, duration: 0.3, ease: "back.out(2.4)" })
          .to(cursor, { autoAlpha: 0, duration: 0.4 }, "+=0.4");
        loopInView(node, tl);
      });

      // Automation: nodes pulse in sequence; a spark travels each connector.
      q<HTMLElement>(".composite.automation").forEach((node) => {
        const nodes = node.querySelectorAll(".flow-node");
        if (nodes.length) {
          const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.6 });
          tl.to(nodes, {
            scale: 1.025,
            duration: 0.4,
            ease: "sine.inOut",
            stagger: { each: 0.5, repeat: 1, yoyo: true },
          });
          loopInView(node, tl);
        }
        node.querySelectorAll<HTMLElement>(".flow-spark").forEach((s, i) => {
          const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.7, delay: i * 0.35 });
          tl.fromTo(
            s,
            { top: "-10%", autoAlpha: 0 },
            { top: "110%", autoAlpha: 1, duration: 1, ease: "power1.inOut" }
          );
          loopInView(node, tl);
        });
      });

      // Brand kit: swatches breathe in a gentle wave.
      q<HTMLElement>(".composite.brandkit").forEach((node) => {
        const sw = node.querySelectorAll(".swatch");
        if (!sw.length) return;
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.9 });
        tl.to(sw, {
          scaleY: 1.16,
          transformOrigin: "bottom",
          duration: 0.4,
          ease: "sine.inOut",
          stagger: { each: 0.1, repeat: 1, yoyo: true },
        });
        loopInView(node, tl);
      });

      // Timeline snippet loops.
      q<HTMLElement>(".tl-build-bar").forEach((bar) => {
        const tl = gsap.timeline({ repeat: -1, yoyo: true });
        tl.fromTo(bar, { scaleX: 0.55 }, { scaleX: 1, duration: 1.8, ease: "sine.inOut" });
        loopInView(bar, tl);
      });
      // uptime bars: a live-activity shimmer
      const upBars = q<HTMLElement>(".tl-uptime-bar");
      if (upBars.length) {
        const tl = gsap.timeline({ repeat: -1, yoyo: true });
        tl.to(upBars, {
          scaleY: 0.45,
          duration: 0.9,
          ease: "sine.inOut",
          stagger: { each: 0.05, from: "random" },
        });
        loopInView(upBars[0].closest(".timeline-mock") || upBars[0], tl);
      }
      // live dots pulse
      q<HTMLElement>(".tl-live-dot").forEach((dot) => {
        const tl = gsap.timeline({ repeat: -1, yoyo: true });
        tl.to(dot, { scale: 1.9, opacity: 0.45, duration: 0.8, ease: "sine.inOut" });
        loopInView(dot.closest(".timeline-mock") || dot, tl);
      });
      // discovery reply arrives on a loop
      q<HTMLElement>(".tl-chat").forEach((chat) => {
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.6 });
        tl.fromTo(
          chat,
          { autoAlpha: 0, y: 8 },
          { autoAlpha: 1, y: 0, duration: 0.5, ease: "power2.out" }
        ).to(chat, { autoAlpha: 0, duration: 0.4 }, "+=2.4");
        loopInView(chat.closest(".timeline-mock") || chat, tl);
      });

      ScrollTrigger.refresh();
    }
  </script>
</BaseLayout>

