---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import HeroAtmosphere from "../components/HeroAtmosphere.astro";
import { allServices } from "../data/services";

// Ordered by how we lead: custom software first, the website that ties
// into it, the automations, then brand and social as supporting work.
const capabilityOrder = ["software", "websites", "ai", "brand"];
const capabilityServices = capabilityOrder
  .map((slug) => allServices.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const processSteps = [
  {
    title: "Discover",
    body: "A free 30-minute discovery call. We learn your business, your stack, and where the friction actually lives. You leave with notes and next steps either way.",
  },
  {
    title: "Plan",
    body: "A real plan with real numbers and a real timeline. Fixed-fee where we can, transparent ranges where we can't.",
  },
  {
    title: "Build",
    body: "We design and ship in tight cycles. You see progress every week, not at the end. Two rounds of revisions are baked in.",
  },
  {
    title: "Launch",
    body: "We handle the boring parts, DNS, analytics, monitoring, training your team. You handle the celebration.",
  },
  {
    title: "Operate",
    body: "Most clients stay on a small retainer. Hosting, backups, the occasional new feature. We're the team you don't have to hire.",
  },
];

const aiExamples = [
  {
    line: "An AI-powered intake summarizer for a therapy practice.",
    detail: "Six hours of weekly admin, gone.",
  },
  {
    line: "Personalized check-in drafts inside a realtor's CRM.",
    detail: "Segmented by sphere, written in their voice.",
  },
  {
    line: "An internal RAG agent over a coaching firm's session notes.",
    detail: "Recommendations in minutes, not hours.",
  },
];
---

<BaseLayout title="elefox studio">
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Hero                                                                 -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section
    id="hero"
    data-glow
    class="relative overflow-hidden min-h-[90vh] flex flex-col justify-center pt-28 md:pt-32 pb-16"
  >
    <HeroAtmosphere />

    <Container size="full" class="relative z-10 text-center">
      <h1 data-split class="font-display font-extrabold tracking-[-0.04em] leading-[0.92] text-[clamp(2.5rem,8vw,6.5rem)] text-ink max-w-[20ch] mx-auto">
        Software built around
        <span class="relative inline-block">
          <em class="not-italic text-gradient-flow">your business</em>,
          <svg viewBox="0 0 260 14" class="absolute left-0 -bottom-2 md:-bottom-3 w-full h-3 text-ember underline-draw" aria-hidden="true" preserveAspectRatio="none">
            <path d="M2 8 Q 40 2, 80 7 T 160 8 T 220 6 T 258 7" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          </svg>
        </span>
        not the other way around.
      </h1>

      <p class="lede mx-auto mt-10 md:mt-12 text-xl md:text-2xl text-graphite text-center">
        Off-the-shelf tools force you to adapt. We build the opposite: CRMs,
        portals, and automations shaped to how you actually work, wired into
        your site (yours or one we build). Brand and social when you need them.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <Button href="/services" size="lg" class="btn-magnetic">See what we do</Button>
        <Button href="/contact" variant="secondary" size="lg" class="btn-magnetic">Start a project</Button>
      </div>
    </Container>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Capabilities, section intro, then a pinned horizontal-scroll panel  -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="pt-16 md:pt-24 pb-12 md:pb-20 relative" id="capabilities">
    <Container size="full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5">
          <Eyebrow>What we do</Eyebrow>
          <h2 data-split class="mt-6">Custom software, at the core.</h2>
        </div>
        <p class="lg:col-span-6 lg:col-start-7 lede self-end">
          It starts with the tools your business runs on: a CRM, a portal,
          the automations behind the scenes. From there we build, or rebuild,
          the website that ties into them. Brand and social round it out when
          you want one team handling all of it.
        </p>
      </div>
    </Container>
  </section>

  {/* Pinned horizontal scroll, the four capability panels                 */}
  <section data-horiz class="bg-cream relative">
    <div class="horiz__inner">
      <div class="horiz__track items-stretch">
        {/* Intro panel, sets context, gives the scroll a beginning */}
        <div class="flex-shrink-0 w-[80vw] md:w-[55vw] flex flex-col justify-center pr-8 md:pr-16">
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-forest mb-4">
            scroll →
          </span>
          <p class="text-3xl md:text-5xl font-display tracking-tight text-ink leading-tight">
            The pieces, in the order we usually build them. Each one connects
            to the next.
          </p>
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-ember mt-8 inline-flex items-center gap-2">
            Keep going
            <svg width="20" height="8" viewBox="0 0 20 8" fill="none" aria-hidden="true"><path d="M0 4h18m0 0l-4-3m4 3l-4 3" stroke="currentColor" stroke-width="1.5"/></svg>
          </span>
        </div>

        {
          capabilityServices.map((s, i) => (
            <a
              href={`/services/${s.slug}`}
              class={`group flex-shrink-0 w-[80vw] md:w-[50vw] bg-white border border-fog hover:border-forest p-8 md:p-14 rounded-xl transition-all duration-500 hover:shadow-lift flex flex-col gap-6 overflow-hidden ${i % 2 === 0 ? "hover:-rotate-1" : "hover:rotate-1"}`}
            >
              <div class="flex items-start justify-between">
                <span class="font-mono text-xs uppercase tracking-[0.14em] text-forest/70">
                  {s.name}
                </span>
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  class="text-graphite group-hover:text-forest group-hover:translate-x-1 group-hover:-translate-y-1 transition-all"
                >
                  <path
                    d="M5 15L15 5M15 5H7M15 5v8"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <h3 class="text-4xl md:text-6xl text-ink mt-auto font-display tracking-tight leading-[0.95]">
                {s.name}.
              </h3>
              <p class="text-graphite text-lg md:text-xl leading-relaxed max-w-md">
                {s.oneLiner}
              </p>
            </a>
          ))
        }

        {/* Tail panel, soft outro */}
        <div class="flex-shrink-0 w-[50vw] md:w-[32vw] flex items-center">
          <span class="text-3xl md:text-5xl font-display font-bold tracking-tight text-ink leading-tight">
            That's the <span class="text-gradient-flow">studio</span>.
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* Featured product, Custom CRM (a real product, not the hero focus)   */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="py-20 md:py-32 bg-forest-wash relative overflow-hidden">
    <Container size="full">
      <div data-reveal class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-6 order-2 lg:order-1">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-xs text-forest tracking-[0.14em] uppercase">Featured product</span>
            <span class="text-mist">·</span>
            <span class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.14em] text-ember">
              <span class="w-1.5 h-1.5 rounded-full bg-ember"></span>
              Live in production
            </span>
          </div>

          <h2 data-split class="mt-2 max-w-[14ch]">
            A Custom CRM, built for how you actually run.
          </h2>

          <p class="lede mt-8 text-xl">
            For realtors, advisors, therapists, and small teams who live in
            their pipeline. Custom fields, your stages, your terminology
            and your data, hosted by us, yours forever. Six-week typical
            build. We use the same engine in our own studio.
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            {["Custom fields", "Your terminology", "Relationship-first", "Hosted by us", "Yours forever"].map((t) => (
              <span class="text-xs font-mono text-forest bg-bone border border-forest/20 px-3 py-1.5 rounded-pill">
                {t}
              </span>
            ))}
          </div>

          <div class="mt-12 flex flex-wrap gap-4">
            <a
              href="/services/software"
              class="inline-flex items-center gap-2 px-6 py-3 bg-forest text-bone rounded-pill font-medium hover:bg-forest-deep transition-colors"
            >
              How we build CRMs
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a
              href="/contact?service=crm"
              class="inline-flex items-center gap-2 px-6 py-3 bg-transparent text-forest border-2 border-forest/40 rounded-pill font-medium hover:bg-forest hover:text-bone transition-colors"
            >
              Talk to us about yours
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 order-1 lg:order-2 relative">
          {/* Product walkthrough */}
          <div class="relative rounded-xl overflow-hidden shadow-lift bg-ink group">
            <video
              id="portal-demo"
              src="/video/portal-overview.mp4"
              poster="/video/portal-poster.jpg"
              playsinline
              preload="metadata"
              aria-label="Client portal walkthrough: project management, contracts, and billing"
              class="block w-full h-auto"
            ></video>
            <button
              type="button"
              id="portal-demo-play"
              aria-label="Play client portal walkthrough"
              class="absolute inset-0 flex items-center justify-center bg-ink/20 hover:bg-ink/10 transition-colors"
            >
              <span class="flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-bone/95 text-forest shadow-lift group-hover:scale-105 transition-transform">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="ml-1">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>
    </Container>

    <script is:inline>
      (() => {
        const video = document.getElementById("portal-demo");
        const btn = document.getElementById("portal-demo-play");
        if (!video || !btn) return;
        btn.addEventListener("click", () => {
          video.setAttribute("controls", "");
          btn.remove();
          video.play().catch(() => {});
        });
      })();
    </script>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Process, five-step                                                  -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-24 md:py-40 relative">
    <Container size="full">
      <div class="max-w-3xl mb-20 md:mb-28">
        <Eyebrow>How we work</Eyebrow>
        <h2 data-split class="mt-6">
          A boutique pace, an agency process.
        </h2>
        <p class="lede mt-6">
          Every engagement runs the same five-step shape. No mystery, no
          surprise invoices, no calls to figure out where the project is.
        </p>
      </div>

      <ol class="space-y-0 relative">
        {/* Vertical connecting line, runs behind all steps */}
        <span class="hidden md:block absolute left-[14px] top-4 bottom-4 w-px bg-gradient-to-b from-ember via-forest/40 to-transparent" aria-hidden="true" />

        {
          processSteps.map((step) => (
            <li data-reveal class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 group py-10 md:py-12 border-t border-fog pl-0 md:pl-12 relative">
              {/* Pulsing dot, vertically centered with the step heading */}
              <span class="hidden md:block absolute left-[8px] top-1/2 -translate-y-1/2 step-dot" aria-hidden="true" />
              <div class="md:col-span-5 self-center">
                <h3 class="text-3xl md:text-5xl text-ink group-hover:text-forest transition-colors font-display tracking-tight">
                  {step.title}.
                </h3>
              </div>
              <p class="md:col-span-7 text-lg text-graphite leading-relaxed self-center">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Why elefox, three pillars                                          -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-24 md:py-40 bg-forest text-bone">
    <Container size="full">
      <div class="max-w-4xl mb-20 md:mb-28">
        <Eyebrow tone="bone">Why elefox</Eyebrow>
        <h2 data-split class="mt-6 text-bone">
          We're built for the people who got told they were "too small" to work with a real studio.
        </h2>
      </div>

      <div data-reveal-stagger class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
        {
          [
            {
              n: "→",
              h: "A cap on intake.",
              p: "We take a small number of software clients each year so every build gets real attention. When we're full, we say so.",
            },
            {
              n: "→",
              h: "Honest about scope.",
              p: "Our pages have a 'skip if' section for a reason. We turn down projects we can't make great. You deserve a yes that means yes.",
            },
            {
              n: "→",
              h: "Built like operators.",
              p: "We use what we ship. Our client portal, our CRM, our automations, we run on them. When something's broken, we feel it first.",
            },
          ].map((pillar) => (
            <div>
              <span class="text-3xl text-bone/40 mb-6 block">{pillar.n}</span>
              <h3 class="text-2xl md:text-3xl text-bone mb-4">{pillar.h}</h3>
              <p class="text-bone/75 text-lg leading-relaxed">{pillar.p}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- AI, editorial section                                              -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-24 md:py-40">
    <Container size="default">
      <Eyebrow>AI & automation</Eyebrow>
      <h2 data-split class="mt-6 mb-12 max-w-3xl">
        The quiet co-worker we wire into your stack.
      </h2>
      <p class="lede text-2xl mb-16">
        AI isn't a product we sell, it's a capability we help you use. Tell us
        your bottleneck. We'll figure out whether AI actually fits, and if it
        does, what the smallest version looks like.
      </p>

      <ul data-reveal-stagger class="space-y-8 mb-16 border-t border-fog">
        {
          aiExamples.map((ex) => (
            <li class="grid grid-cols-1 md:grid-cols-12 gap-4 py-8 border-b border-fog group">
              <div class="md:col-span-8">
                <p class="text-2xl md:text-3xl text-ink font-display tracking-tight leading-tight">
                  {ex.line}
                </p>
              </div>
              <div class="md:col-span-4 md:text-right self-end">
                <span class="text-sm font-mono text-forest tracking-wide">
                  {ex.detail}
                </span>
              </div>
            </li>
          ))
        }
      </ul>

      <Button href="/services/ai" variant="secondary" size="lg">
        How we engage on AI
      </Button>
    </Container>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- CTA band                                                            -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-24 md:py-40 bg-ink text-bone">
    <Container size="full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8">
          <Eyebrow tone="bone">Tell us what you're building</Eyebrow>
          <h2 class="mt-6 text-bone display-xl">
            Let's figure it out together.
          </h2>
        </div>
        <div class="lg:col-span-4 flex flex-wrap gap-4 lg:justify-end">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-bone text-ink rounded-pill text-lg font-medium hover:bg-cream transition-colors"
          >
            Start a project →
          </a>
          <a
            href="/contact#book"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent text-bone border-2 border-bone/70 rounded-pill text-lg font-medium hover:bg-bone hover:text-forest transition-colors"
          >
            Book a call
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
