---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import HeroAtmosphere from "../components/HeroAtmosphere.astro";
import InlineLeadForm from "../components/InlineLeadForm.astro";

// What the audit covers.
const checks = [
  { t: "Speed & performance", p: "Load times, image weight, the lag that makes visitors bounce before they read a word." },
  { t: "Mobile experience", p: "How it actually behaves on a phone, where most of your traffic already is." },
  { t: "SEO foundations", p: "Titles, structure, and the basics Google needs to find and rank you at all." },
  { t: "Lead capture", p: "Whether the path from visitor to enquiry is obvious, or quietly leaking prospects." },
  { t: "Design & trust", p: "First impressions: does it look like a business someone should hand money to?" },
  { t: "Accessibility", p: "The things that lock out real users, and increasingly, invite legal trouble." },
];

// How it works.
const steps = [
  { t: "Send your URL", p: "Drop your website address in the form. That's the whole ask, no call required to start." },
  { t: "We audit it", p: "A real person goes through your site against the checklist above. Back to you within two business days." },
  { t: "You get the report", p: "A clear, prioritized breakdown of what to fix first, plus an optional call to walk through it. Yours to keep." },
];
---

<BaseLayout
  title="Free Website Audit"
  description="A free, no-strings audit of your website — speed, mobile, SEO, lead capture, and the things quietly costing you customers. Real feedback from a real studio."
>
  <!-- Hero -->
  <section class="pt-2 md:pt-4">
    <Container size="full">
      <div
        data-glow
        class="relative overflow-hidden rounded-[28px] md:rounded-[44px] pt-28 md:pt-36 pb-16 md:pb-24 px-6 md:px-12 bg-gradient-to-b from-[#FBF1E9] via-[#F8ECE0] to-[#F2E2D2]"
      >
        <HeroAtmosphere warm />
        <div class="relative z-10 text-center max-w-4xl mx-auto">
          <div class="mb-8 flex justify-center">
            <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.14em] text-forest bg-bone border border-forest/25 px-4 py-1.5 rounded-pill">
              <span class="w-1.5 h-1.5 rounded-full bg-ember"></span>
              Free · No strings
            </span>
          </div>

          <h1 data-split class="display-xl text-ink max-w-[17ch] mx-auto">
            Find out what your website is
            <span class="whitespace-nowrap"><span class="text-gradient-flow">costing you</span>.</span>
          </h1>

          <p class="lede mt-10 text-xl md:text-2xl max-w-3xl mx-auto text-center">
            A free audit of your site — speed, mobile, SEO, and the things quietly
            losing you leads. Real feedback from a real studio, not an automated
            score you can't do anything with.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-4 justify-center">
            <Button href="#lead" size="lg" class="btn-magnetic">Get my free audit →</Button>
            <a href="#checks" class="inline-flex items-center gap-2 text-forest font-medium hover:gap-3 transition-all">
              See what we check
            </a>
          </div>
          <p class="mt-6 text-sm font-mono text-graphite">
            Back to you in 2 business days · yours to keep either way
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we check -->
  <section id="checks" class="py-20 md:py-28 scroll-mt-24">
    <Container size="full">
      <div data-reveal class="max-w-2xl mb-12 md:mb-16">
        <Eyebrow>What we check</Eyebrow>
        <h2 data-split class="mt-6">Six places a website leaks money.</h2>
      </div>
      <div data-reveal-stagger class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {
          checks.map((c) => (
            <div class="rounded-2xl border border-fog bg-white p-7 md:p-8">
              <h3 class="text-xl md:text-2xl text-ink mb-3">{c.t}</h3>
              <p class="text-graphite leading-relaxed">{c.p}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- How it works -->
  <section class="py-6 md:py-10">
    <Container size="full">
      <div class="bg-forest-wash rounded-[28px] md:rounded-[40px] px-6 md:px-16 py-16 md:py-24">
        <div data-reveal class="max-w-2xl mb-12 md:mb-16">
          <Eyebrow>How it works</Eyebrow>
          <h2 data-split class="mt-6">Three steps. No sales trap.</h2>
        </div>
        <div data-reveal-stagger class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {
            steps.map((s, i) => (
              <div>
                <span class="text-2xl font-display font-bold text-forest tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="text-xl md:text-2xl text-ink mt-4 mb-3">{s.t}</h3>
                <p class="text-graphite leading-relaxed">{s.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Why free + the form -->
  <section class="py-20 md:py-28">
    <Container size="full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-6">
          <Eyebrow>Why it's free</Eyebrow>
          <h2 data-split class="mt-6">No catch. Here's the honest version.</h2>
          <p class="lede mt-8">
            A good audit is the fastest way to show you we know what we're doing.
            If you want us to fix what we find, we're right here. If you'd rather
            hand it to someone else, or fix it yourself, the report is still yours
            to keep.
          </p>
          <ul class="mt-10 space-y-4">
            {
              [
                "A real person reviews your site, not a scanner",
                "Prioritized by impact, so you know what to fix first",
                "Plain English, no jargon dump",
                "Zero obligation to work with us",
              ].map((point) => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 16 16" fill="none" class="text-forest mt-1 flex-shrink-0" aria-hidden="true">
                    <path d="M3 8.5L6 11.5L13 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="text-lg text-ink leading-snug">{point}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:col-span-6 lg:sticky lg:top-28">
          <InlineLeadForm
            title="Get your free audit"
            subtitle="Drop your website URL. A real breakdown lands in your inbox within two business days."
            serviceValue="website-audit"
            industry="audit"
            toolLabel="Your website URL"
            toolPlaceholder="yourbusiness.com"
            source="audit-landing"
            submitLabel="Send my site for a free audit →"
            successBody="Your free audit is on its way — expect it within two business days. Want to talk sooner? Call 954.780.6508."
          />
          <p class="mt-5 text-center text-sm text-graphite">
            Prefer to talk it through first? Call
            <a href="tel:+19547806508" class="text-forest font-medium hover:text-forest-deep hover:underline">954.780.6508</a>.
          </p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
