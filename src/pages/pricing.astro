---
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import EndCTA from "../components/EndCTA.astro";
import Doodle, { type DoodleName } from "../components/Doodle.astro";
import { menuServices, type Tier } from "../data/services";

// Lowest one-time price in a service, for the "from" line on its tile.
// Monthly tiers and "Custom" are skipped so the number is an honest start.
function startingPrice(tiers: Tier[]) {
  const priced = tiers
    .filter((t) => t.price.includes("$") && !t.cadence?.startsWith("/"))
    .map((t) => Number(t.price.replace(/[^0-9]/g, "")));
  return priced.length ? `$${Math.min(...priced).toLocaleString("en-US")}` : "Custom";
}

// One picker tile and one panel per service, straight from the services menu.
const groups = menuServices.map((s) => ({
  slug: s.slug,
  name: s.name,
  short: s.shortName,
  oneLiner: s.oneLiner,
  from: startingPrice(s.tiers ?? []),
  tiers: s.tiers ?? [],
}));

// Grid columns follow the tier count, so a 3-tier service never shows an
// empty fourth column.
const cols = (n: number) =>
  n >= 4 ? "md:grid-cols-2 xl:grid-cols-4" : n === 3 ? "md:grid-cols-3" : "md:grid-cols-2";

const retainers = [
  { name: "Site Care", price: "$200", cadence: "/month", blurb: "Content updates, security, analytics, priority turnaround on small changes." },
  { name: "Platform Care", price: "$500", cadence: "/month", blurb: "For custom software and portals: hosting, texting, backups, support for your team, and small changes." },
  { name: "Growth Partner", price: "$1,250", cadence: "/month", blurb: "One new automation or feature every month, aimed at whatever eats your time. Includes Platform Care." },
  { name: "Software Hosting", price: "From $50", cadence: "/month", blurb: "Backups, uptime monitoring, security patches, bug fixes." },
  { name: "Hourly add-ons", price: "$150", cadence: "/hour", blurb: "New features, integrations, and workflow changes, billed by the hour." },
];

const finePrint = [
  { t: "50/50 split", d: "Half up front to lock the timeline, half on delivery. No retainer required to start a build." },
  { t: "Two revision rounds", d: "Every build includes two rounds of revisions. Substantial scope changes are billed at the hourly rate." },
  { t: "25-client software cap", d: "We keep our active custom software roster small. When we're full, we're full." },
  { t: "Ownership", d: "When the build is complete and paid, the code and assets are yours. You can take them anywhere." },
];
---

<BaseLayout title="Pricing" description="Transparent pricing for every service we offer, plus ongoing support and hosting.">
  <PageHeader
    title="What it costs, with no surprise scope."
    accent="surprise scope"
    lede={`Every build starts with a fixed 50% deposit, with the other half due on delivery and two rounds of revisions included. Custom work comes with a clear range up front, not a shrug and a "depends on scope."`}
  />

  <!-- Pick a service, see its tiers. Without JS the tiles are jump links and
       every panel shows, stacked. -->
  <section class="pt-12 md:pt-16 pb-16 md:pb-24" data-pricing>
    <Container size="full">
      <div
        role="tablist"
        aria-label="Services"
        class="-mx-6 px-6 md:mx-0 md:px-0 flex md:grid md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4 overflow-x-auto md:overflow-visible snap-x scroll-px-6 md:scroll-px-0 pb-2 md:pb-0"
      >
        {
          groups.map((g, i) => (
            <a
              href={`#${g.slug}`}
              role="tab"
              id={`tab-${g.slug}`}
              aria-controls={g.slug}
              aria-selected={i === 0 ? "true" : "false"}
              data-tab={g.slug}
              class="pick-tile snap-start shrink-0 w-[10.5rem] md:w-auto rounded-2xl border border-fog bg-bone px-4 pt-3 pb-5 transition-colors hover:border-mist aria-selected:border-forest aria-selected:bg-white"
            >
              <Doodle name={g.slug as DoodleName} class="w-16 h-16 md:w-[4.5rem] md:h-[4.5rem] -ml-1" />
              <span class="block mt-2 font-display font-bold text-lg text-ink leading-tight">{g.short}</span>
              <span class="block mt-1 text-sm text-graphite">
                {g.from === "Custom" ? "Custom quote" : <>From <span class="text-forest font-semibold">{g.from}</span></>}
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-12 md:mt-16">
        {
          groups.map((g) => (
            <section
              id={g.slug}
              role="tabpanel"
              aria-labelledby={`tab-${g.slug}`}
              class="price-panel scroll-mt-28 pb-12 last:pb-0"
            >
              <div class="mb-8 md:mb-10 grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-10 items-end">
                <div class="lg:col-span-8">
                  <h2 class="text-3xl md:text-[2.75rem] leading-[1.05]">{g.name}</h2>
                  <p class="mt-3 text-lg text-graphite max-w-2xl">{g.oneLiner}</p>
                </div>
                <a
                  href={`/services/${g.slug}`}
                  class="lg:col-span-4 lg:justify-self-end group inline-flex items-center gap-2 text-forest font-medium hover:gap-3 transition-all"
                >
                  More about {g.short.toLowerCase()}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M2 8h11m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>

              <div class:list={["grid grid-cols-1 gap-5 md:gap-6", cols(g.tiers.length)]}>
                {g.tiers.map((tier) => (
                  <a
                    href={`/contact?service=${g.slug}`}
                    class="group bg-white border border-fog hover:border-forest rounded-2xl p-7 md:p-8 flex flex-col transition-colors"
                  >
                    <h3 class="text-xl md:text-2xl text-ink">{tier.name}</h3>
                    <div class="mt-3 flex items-baseline gap-2 flex-wrap">
                      {tier.price.includes("$") ? (
                        <span class="text-3xl md:text-4xl font-display font-bold text-forest tracking-tight">{tier.price}</span>
                      ) : (
                        <span class="text-sm font-mono uppercase tracking-[0.14em] text-forest border border-forest/30 px-3 py-1 rounded-pill">{tier.price}</span>
                      )}
                      {tier.cadence && <span class="text-sm text-graphite">{tier.cadence}</span>}
                    </div>
                    <p class="mt-4 text-graphite leading-relaxed">{tier.blurb}</p>
                    <ul class="mt-6 pt-6 border-t border-fog space-y-2.5 text-sm text-ink">
                      {tier.features.map((f) => (
                        <li class="flex items-start gap-2.5">
                          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-forest mt-0.5 shrink-0" aria-hidden="true">
                            <path d="M3 8.5L6 11.5L13 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          {f}
                        </li>
                      ))}
                    </ul>
                    <span class="mt-auto pt-7 inline-flex items-center gap-2 text-sm text-forest font-medium group-hover:gap-3 transition-all">
                      Get a quote
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M2 8h11m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </Container>

    <script is:inline>
      (() => {
        const root = document.querySelector("[data-pricing]");
        if (!root) return;
        const tabs = [...root.querySelectorAll('[role="tab"]')];
        const panels = [...root.querySelectorAll('[role="tabpanel"]')];
        root.classList.add("is-tabbed");
        const select = (slug, focus) => {
          tabs.forEach((t) => {
            const on = t.dataset.tab === slug;
            t.setAttribute("aria-selected", on ? "true" : "false");
            t.tabIndex = on ? 0 : -1;
            if (on && focus) t.focus();
          });
          panels.forEach((p) => p.classList.toggle("is-active", p.id === slug));
        };
        const fromHash = tabs.find((t) => "#" + t.dataset.tab === location.hash);
        select((fromHash || tabs[0]).dataset.tab);
        tabs.forEach((t, i) => {
          t.addEventListener("click", (e) => {
            e.preventDefault();
            select(t.dataset.tab);
            history.replaceState(null, "", "#" + t.dataset.tab);
          });
          t.addEventListener("keydown", (e) => {
            const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
            if (!step) return;
            e.preventDefault();
            const next = tabs[(i + step + tabs.length) % tabs.length];
            select(next.dataset.tab, true);
            history.replaceState(null, "", "#" + next.dataset.tab);
          });
        });
      })();
    </script>
  </section>

  <!-- Not sure where to start -->
  <section class="pb-16 md:pb-24">
    <Container size="full" data-reveal>
      <a href="/audit" class="group block bg-forest text-bone rounded-[24px] px-6 md:px-12 py-9 md:py-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
          <div class="lg:col-span-8">
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-bone/70">Not sure where to start?</p>
            <h2 class="mt-3 text-2xl md:text-3xl text-bone tracking-tight max-w-[30ch]">
              Start with a free website audit. We'll tell you what to fix first.
            </h2>
          </div>
          <div class="lg:col-span-4 lg:text-right">
            <span class="inline-flex items-center gap-2 px-6 py-3.5 bg-bone text-ink rounded-pill text-lg font-medium group-hover:gap-3 transition-all">
              Get my free audit
              <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </div>
      </a>
    </Container>
  </section>

  <!-- Retainers -->
  <section id="retainers" class="pb-16 md:pb-24 scroll-mt-28">
    <Container size="full" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl md:text-4xl">Retainers</h2>
          <p class="mt-4 text-lg text-graphite">For after launch: keep it running, or keep it growing.</p>
        </div>
        <div class="lg:col-span-8 border-t border-fog">
          {
            retainers.map((r) => (
              <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 py-6 md:py-7 border-b border-fog">
                <h3 class="md:col-span-4 text-xl text-ink">{r.name}</h3>
                <p class="md:col-span-3 flex items-baseline gap-1.5">
                  <span class="text-2xl font-display font-bold text-forest tracking-tight">{r.price}</span>
                  <span class="text-sm text-graphite">{r.cadence}</span>
                </p>
                <p class="md:col-span-5 text-graphite leading-relaxed">{r.blurb}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Terms -->
  <section class="pb-20 md:pb-28">
    <Container size="full" data-reveal>
      <div class="bg-cream rounded-[28px] md:rounded-[36px] px-6 md:px-14 py-12 md:py-16">
        <h2 class="text-3xl md:text-4xl">The fine print, in plain English.</h2>
        <dl class="mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 md:gap-y-10">
          {
            finePrint.map(({ t, d }) => (
              <div>
                <dt class="flex items-center gap-3 text-xl text-ink font-display font-bold tracking-tight">
                  <span class="w-2 h-2 rounded-full bg-ember shrink-0" aria-hidden="true" />
                  {t}
                </dt>
                <dd class="mt-3 text-graphite leading-relaxed">{d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </Container>
  </section>

  <EndCTA heading="Want a quote with your name on it?" />
</BaseLayout>

<style>
  /* Once the tabs script runs, only the chosen service's panel shows. */
  [data-pricing].is-tabbed .price-panel:not(.is-active) {
    display: none;
  }
  [data-pricing].is-tabbed .price-panel {
    padding-bottom: 0;
  }

  /* Only the chosen (or hovered) tile's doodle moves; the rest hold their
     finished pose so six loops don't compete. */
  .pick-tile[aria-selected="false"]:not(:hover) :global(.dd *) {
    animation: none !important;
  }

  .pick-tile:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 3px;
  }
</style>
