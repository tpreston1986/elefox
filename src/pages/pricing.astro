---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import EndCTA from "../components/EndCTA.astro";
import HeroAtmosphere from "../components/HeroAtmosphere.astro";
import { menuServices } from "../data/services";

// Capability pricing, straight from the mirrored services menu.
const allTiers = menuServices.map((s) => ({
  category: s.name,
  tiers: s.tiers ?? [],
}));

const retainers = [
  { name: "Site Care", price: "$200", cadence: "/month", blurb: "Content updates, security, analytics, priority turnaround on small changes." },
  { name: "Software Hosting", price: "From $50", cadence: "/month", blurb: "Backups, uptime monitoring, security patches, bug fixes.", badge: "Most Popular" },
  { name: "Hourly add-ons", price: "$150", cadence: "/hour", blurb: "New features, integrations, workflow changes, billed in honest increments." },
];
---

<BaseLayout title="Pricing" description="Transparent pricing for two flagship offers and seven services — plus ongoing support.">
  <section class="pt-2 md:pt-4">
    <Container size="full">
      <div data-glow class="relative overflow-hidden rounded-[28px] md:rounded-[44px] pt-28 md:pt-36 pb-16 md:pb-24 px-6 md:px-12 bg-gradient-to-b from-[#FBF1E9] via-[#F8ECE0] to-[#F2E2D2]">
        <HeroAtmosphere warm />
        <div class="relative z-10 text-center max-w-4xl mx-auto">
          <Eyebrow>Pricing</Eyebrow>
          <h1 data-split class="display-xl mt-6 max-w-[18ch] mx-auto">
            Honest numbers. No
            <span class="whitespace-nowrap"><span class="text-gradient-flow">surprise scope</span>.</span>
          </h1>
          <p class="lede mt-10 text-xl max-w-3xl mx-auto text-center">
            Every build has a fixed-fee deposit (50% to start, 50% on delivery)
            and two rounds of revisions baked in. Custom work runs in transparent
            ranges, not vague "depending on scope" hand-waving.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Free audit banner -->
  <section class="py-10 md:py-14">
    <Container size="full" data-reveal>
      <a href="/audit" class="group relative block bg-forest text-bone rounded-[24px] px-6 md:px-12 py-10 md:py-12 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
          <div class="lg:col-span-8">
            <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.14em] text-bone/70 mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-ember"></span>
              Free · No strings
            </span>
            <h2 class="text-2xl md:text-4xl text-bone tracking-tight max-w-[22ch]">
              Not sure where to start? Get a free website audit.
            </h2>
          </div>
          <div class="lg:col-span-4 lg:text-right">
            <span class="inline-flex items-center gap-2 px-6 py-3.5 bg-bone text-ink rounded-pill text-lg font-medium group-hover:gap-3 transition-all">
              Get my free audit
              <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </div>
      </a>
    </Container>
  </section>

  <!-- All capability tier categories -->
  {
    allTiers.map((group) => (
      <section class="py-16 md:py-24">
        <Container size="full" data-reveal>
          <div class="mb-12">
            <Eyebrow>{group.category}</Eyebrow>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {group.tiers.map((tier) => (
              <article class={`relative bg-white border rounded-xl p-8 flex flex-col ${tier.badge ? "border-forest" : "border-fog"}`}>
                {tier.badge && (
                  <span class="absolute -top-3 left-6 bg-forest text-bone text-xs font-mono uppercase tracking-wider px-3 py-1 rounded-pill">
                    {tier.badge}
                  </span>
                )}
                <h3 class="text-2xl text-ink mb-3">{tier.name}</h3>
                <div class="mb-5 flex items-baseline gap-2 flex-wrap">
                  {tier.price.includes("$") ? (
                    <span class="text-3xl font-display font-bold text-forest tracking-tight">{tier.price}</span>
                  ) : (
                    <span class="text-sm font-mono uppercase tracking-[0.14em] text-forest border border-forest/30 px-3 py-1 rounded-pill">{tier.price}</span>
                  )}
                  {tier.cadence && <span class="text-sm text-graphite">{tier.cadence}</span>}
                </div>
                <p class="text-sm text-graphite leading-relaxed">{tier.blurb}</p>
              </article>
            ))}
          </div>
        </Container>
      </section>
    ))
  }

  <!-- Retainers -->
  <section class="py-16 md:py-24">
    <Container size="full" data-reveal>
      <div class="mb-12">
        <Eyebrow>Retainers, keep it running</Eyebrow>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          retainers.map((r) => (
            <article class={`relative bg-cream border rounded-xl p-8 ${r.badge ? "border-forest" : "border-fog"}`}>
              {r.badge && (
                <span class="absolute -top-3 left-6 bg-forest text-bone text-xs font-mono uppercase tracking-wider px-3 py-1 rounded-pill">
                  {r.badge}
                </span>
              )}
              <h3 class="text-2xl text-ink mb-3">{r.name}</h3>
              <div class="mb-5 flex items-baseline gap-2 flex-wrap">
                <span class="text-3xl font-display font-bold text-forest tracking-tight">{r.price}</span>
                <span class="text-sm text-graphite">{r.cadence}</span>
              </div>
              <p class="text-graphite leading-relaxed">{r.blurb}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Terms -->
  <section class="py-20 md:py-32">
    <Container size="default" data-reveal>
      <Eyebrow>Terms</Eyebrow>
      <h2 class="mt-6 mb-12">The fine print, in plain English.</h2>
      <dl class="space-y-8">
        {
          [
            { t: "50/50 split", d: "Half up front to lock the timeline, half on delivery. No retainer required to start a build." },
            { t: "Two revision rounds", d: "Every build includes two rounds of revisions. Substantial scope changes are billed honestly at the hourly rate." },
            { t: "25-client software cap", d: "We keep our active custom software roster small. When we're full, we're full." },
            { t: "Ownership", d: "When the build is complete and paid, the code and assets are yours. You can take them anywhere." },
          ].map(({ t, d }) => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 border-b border-fog pb-8">
              <dt class="md:col-span-4 text-xl text-ink font-display tracking-tight">{t}</dt>
              <dd class="md:col-span-8 text-lg text-graphite leading-relaxed">{d}</dd>
            </div>
          ))
        }
      </dl>
    </Container>
  </section>

  <EndCTA heading="Ready to put real numbers on a real plan?" />
</BaseLayout>
