---
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import EndCTA from "../../components/EndCTA.astro";

const principles = [
  {
    t: "We pick fewer projects, on purpose.",
    p: "Our custom software roster is capped at 25 active clients. So every build gets real attention, and sometimes we have to say no. We're okay with that.",
  },
  {
    t: "We use what we ship.",
    p: "We built this website, we run the studio on our own CRM, and our automations run our business before they ever touch yours. If something breaks, we feel it before you do.",
  },
  {
    t: "We tell you when AI won't help.",
    p: "We've built AI features into a dozen client workflows. We've also turned down AI projects where the right answer was a better form or a clearer process.",
  },
  {
    t: "We don't disappear after launch.",
    p: "Most builds roll into a small monthly retainer for hosting, support, and the occasional new feature. You won't be left holding a login and a prayer.",
  },
];

const collaborators = [
  { role: "Design + product", scope: "Strategy, UX, brand, frontend" },
  { role: "Engineering", scope: "Backend, integrations, AI pipelines" },
  { role: "Content + copy", scope: "Site copy, newsletters, brand voice (when needed)" },
  { role: "Illustration", scope: "Custom illustration + iconography (on retainer projects)" },
];
---

<BaseLayout
  title="About"
  description="elefox studio is a small development studio based in South Florida. Here's how we work."
>
  <!-- Hero -->
  <PageHeader
    title="A small studio that does the work most agencies pass on."
    accent="pass on"
    lede="elefox studio is a development studio in South Florida. We build websites, custom software, brand systems, and quiet little AI automations for small companies that have outgrown templates."
  />

  <!-- The founder (this used to be its own page at /about/founder). The
       photo runs off the right edge and dissolves into the page on its other
       sides, so it sits in the page instead of in a frame. -->
  <section id="founder" class="relative scroll-mt-24">
    <div class="founder-photo lg:absolute lg:inset-y-0 lg:right-0 lg:w-[58%]">
      <img
        src="/people/tiffany-studio.webp"
        srcset="/people/tiffany-studio-960.webp 960w, /people/tiffany-studio.webp 1672w"
        sizes="(min-width: 1024px) 58vw, 100vw"
        alt="Tiffany Russell at her desk in the elefox studio, coffee mug and laptop in front of her"
        width="1672"
        height="941"
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>
    <Container size="full">
      <div class="relative lg:min-h-[680px] lg:grid lg:grid-cols-12 lg:items-center">
        <div data-reveal class="lg:col-span-5 -mt-10 lg:mt-0 pb-8 lg:py-24">
          <h2 class="max-w-[14ch]">
            Hi. I'm Tiffany. I started <span class="text-forest">elefox</span>.
          </h2>
          <p class="mt-6 flex items-center gap-3 text-sm text-graphite">
            <span class="w-8 h-px bg-ember inline-block shrink-0"></span>
            Coral Springs, somewhere between coffee #2 and a deploy
          </p>
          <p class="mt-8 text-lg md:text-xl text-graphite leading-relaxed">
            I've been designing and building websites and software for over 15
            years: in-house, at agencies, and on my own. People kept hiring me
            for the same reason. I could work out the plan, design it, and then
            build it myself.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="pt-4 lg:pt-10 pb-20 md:pb-32">
    <Container size="full">
      <div data-reveal class="max-w-[62ch] space-y-7 text-lg md:text-xl text-graphite leading-relaxed">
        <p>
          I've built an intake system for a therapy practice, a CRM for a
          realtor who was done bending to someone else's, and a site for a
          financial planning firm that needed it to actually bring in leads.
          After enough of those, I figured I should just open a studio.
        </p>
        <p>
          The tools change constantly, so I keep learning the new stuff (AI
          included). That way what I build still feels current two years after
          launch.
        </p>
        <p>
          About the name: <strong class="text-ink font-medium">elefox</strong>
          is my kids. My daughter's nursery was all elephants, my son's was all
          foxes, and I have both tattooed on my arm. When the studio needed a
          name that wasn't mine, theirs was right there.
        </p>
        <div class="pt-3 flex items-center gap-4">
          <span class="font-mono text-xs uppercase tracking-wider text-graphite">signed,</span>
          <span class="font-display font-bold text-3xl md:text-4xl tracking-tight text-forest">Tiffany</span>
        </div>
      </div>
    </Container>
  </section>

  <!-- Principles -->
  <section class="py-20 md:py-32">
    <Container size="full" data-reveal>
      <div class="max-w-3xl mb-16 md:mb-20">
        <h2>Four principles we don't flex on.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        {
          principles.map((p) => (
            <article class="border-t-2 border-forest pt-8">
              <h3 class="text-2xl md:text-3xl text-ink mb-4">{p.t}</h3>
              <p class="text-lg text-graphite leading-relaxed">{p.p}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Collaborators -->
  <section class="py-6 md:py-12">
    <Container size="full">
      <div data-reveal class="bg-ink text-bone rounded-[28px] md:rounded-[40px] px-6 md:px-16 py-20 md:py-32">
        <div class="max-w-3xl mb-16">
          <h2 class="text-bone">
            One founder, plus the right people.
          </h2>
          <p class="lede text-bone/75 mt-6 text-xl">
            Tiffany runs elefox. When a job needs an extra specialist, she
            brings in collaborators she trusts. We won't pretend to be a
            40-person agency, but you do get more than one brain on your
            project.
          </p>
        </div>

        <div class="border-t border-bone/20">
          {
            collaborators.map((c) => (
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-8 border-b border-bone/20">
                <span class="md:col-span-5 text-xl text-bone font-display tracking-tight">{c.role}</span>
                <span class="md:col-span-7 text-lg text-bone/75 self-center">{c.scope}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <EndCTA
    heading="The worst outcome is a free conversation."
    primary={{ label: "Book a call", href: "/contact#book" }}
    secondary={{ label: "Send a message", href: "/contact" }}
  />
</BaseLayout>

<style>
  .founder-photo {
    aspect-ratio: 1 / 1;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 66%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 66%, transparent);
  }
  .founder-photo img {
    object-position: 36% 30%;
  }
  @media (min-width: 1024px) {
    .founder-photo {
      aspect-ratio: auto;
      -webkit-mask-image:
        linear-gradient(to right, transparent, #000 24%),
        linear-gradient(to bottom, transparent, #000 14%, #000 78%, transparent);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent, #000 24%),
        linear-gradient(to bottom, transparent, #000 14%, #000 78%, transparent);
      mask-composite: intersect;
    }
    .founder-photo img {
      object-position: 30% 30%;
    }
  }
</style>
