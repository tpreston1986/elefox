---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Button from "../../components/Button.astro";
import EndCTA from "../../components/EndCTA.astro";
import HeroAtmosphere from "../../components/HeroAtmosphere.astro";

const principles = [
  {
    t: "We pick fewer projects, on purpose.",
    p: "Our custom software roster is capped at 25 active clients. That means every build gets real attention, and that means we sometimes have to say no. It's a feature, not a bug.",
  },
  {
    t: "We use what we ship.",
    p: "Our client portal? We built it. Our CRM? We use it. Our automations? They run our own business first. When something's broken, we feel it before you do.",
  },
  {
    t: "We tell you when AI won't help.",
    p: "We've built AI features into a dozen client workflows. We've also turned down AI engagements where the right answer was a better form or a clearer process. Honest first, clever second.",
  },
  {
    t: "We don't disappear after launch.",
    p: "Most builds roll into a small monthly retainer for hosting, support, and the occasional new feature. We're the team you don't have to hire.",
  },
];

const collaborators = [
  { role: "Design + product", scope: "Strategy, UX, brand, frontend" },
  { role: "Engineering", scope: "Backend, integrations, AI pipelines" },
  { role: "Content + copy", scope: "Site copy, newsletters, brand voice (when needed)" },
  { role: "Illustration", scope: "Custom illustration + iconography (on retainer projects)" },
];
---

<BaseLayout
  title="About"
  description="elefox studio is a small design and product studio based in South Florida. Here's how we work."
>
  <!-- Hero -->
  <section class="pt-2 md:pt-4">
    <Container size="full">
      <div data-glow class="relative overflow-hidden rounded-[28px] md:rounded-[44px] pt-28 md:pt-36 pb-16 md:pb-24 px-6 md:px-12 bg-gradient-to-b from-[#FBF1E9] via-[#F8ECE0] to-[#F2E2D2]">
        <HeroAtmosphere warm />
        <div class="relative z-10 text-center max-w-4xl mx-auto">
          <Eyebrow>About the studio</Eyebrow>
          <h1 data-split class="display-xl mt-6 max-w-[20ch] mx-auto">
            A small studio that does the work most agencies
            <span class="text-gradient-flow">pass on</span>.
          </h1>
          <p class="lede mt-10 text-xl max-w-3xl mx-auto text-center">
            elefox studio is a design and product studio based in South Florida. We
            build websites, custom software, brand systems, and quiet AI
            automations for the small companies that deserve more than a template.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- The story -->
  <section class="py-20 md:py-32">
    <Container size="default" data-reveal>
      <Eyebrow>Why we exist</Eyebrow>
      <h2 data-split class="mt-6 mb-12">The studio in three paragraphs.</h2>
      <div class="space-y-8 text-lg md:text-xl text-graphite leading-relaxed max-w-3xl">
        <p>
          We've worked in design and code in every flavor, in-house,
          agency, freelance, now studio. Long enough to know what works.
          Still rebuilding our own stack every year because the work doesn't
          sit still and neither should we. Old enough to be useful, current
          enough to be honest about what's changed.
        </p>
        <p>
          The studio is small on purpose. We're founder-led and supported by
          a network of trusted collaborators, engineers, illustrators,
          copywriters, who plug in when a project calls for them. We say
          "we" because more than one person touches your work. We say "the
          studio is small" because honesty travels further than scale.
        </p>
        <p>
          We work with service businesses, small SaaS, local operators, and
          founders who got told they were "too small" for a real studio.
          They're our people.
        </p>
      </div>
      <div class="mt-10">
        <Button href="/about/founder" variant="link">
          → Meet the founder
        </Button>
      </div>
    </Container>
  </section>

  <!-- Principles -->
  <section class="py-20 md:py-32">
    <Container size="full" data-reveal>
      <div class="max-w-3xl mb-16 md:mb-20">
        <Eyebrow>How we work</Eyebrow>
        <h2 data-split class="mt-6">Four principles we don't flex on.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        {
          principles.map((p) => (
            <article class="border-t-2 border-forest pt-8">
              <h3 class="text-2xl md:text-3xl text-ink mb-4">{p.t}</h3>
              <p class="text-lg text-graphite leading-relaxed">{p.p}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Collaborators -->
  <section class="py-6 md:py-12">
    <Container size="full">
      <div data-reveal class="bg-ink text-bone rounded-[28px] md:rounded-[40px] px-6 md:px-16 py-20 md:py-32">
        <div class="max-w-3xl mb-16">
          <Eyebrow tone="bone">The team, honestly</Eyebrow>
          <h2 class="mt-6 text-bone">
            Founder-led. Collaborator-supported.
          </h2>
          <p class="lede text-bone/75 mt-6 text-xl">
            elefox is run by Tiffany (the founder) and supported by a trusted
            network of specialist collaborators we bring in when the work calls
            for it. We don't fake team size, but you do get more than one brain
            on your project.
          </p>
        </div>

        <div class="border-t border-bone/20">
          {
            collaborators.map((c) => (
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-8 border-b border-bone/20">
                <span class="md:col-span-5 text-xl text-bone font-display tracking-tight">{c.role}</span>
                <span class="md:col-span-7 text-lg text-bone/75 self-center">{c.scope}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <EndCTA heading="Want to know who's actually doing the work?" primary={{ label: "Meet the founder", href: "/about/founder" }} secondary={{ label: "Start a project", href: "/contact" }} />
</BaseLayout>
