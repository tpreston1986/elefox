---
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import EndCTA from "../../components/EndCTA.astro";

const principles = [
  {
    t: "We pick fewer projects, on purpose.",
    p: "Our custom software roster is capped at 25 active clients. So every build gets real attention, and sometimes we have to say no. We're okay with that.",
  },
  {
    t: "We use what we ship.",
    p: "We built this website, we run the studio on our own CRM, and our automations run our business before they ever touch yours. If something breaks, we feel it before you do.",
  },
  {
    t: "We tell you when AI won't help.",
    p: "We've built AI features into a dozen client workflows. We've also turned down AI projects where the right answer was a better form or a clearer process.",
  },
  {
    t: "We don't disappear after launch.",
    p: "Most builds roll into a small monthly retainer for hosting, support, and the occasional new feature. You won't be left holding a login and a prayer.",
  },
];

const facts = [
  { t: "Based", d: "Coral Springs, FL" },
  { t: "Experience", d: "15+ years" },
  { t: "Toolkit", d: "Figma · Astro · Next.js · AI agents" },
  { t: "Studio focus", d: "Relationship-driven small teams" },
];

const collaborators = [
  { role: "Design + product", scope: "Strategy, UX, brand, frontend" },
  { role: "Engineering", scope: "Backend, integrations, AI pipelines" },
  { role: "Content + copy", scope: "Site copy, newsletters, brand voice (when needed)" },
  { role: "Illustration", scope: "Custom illustration + iconography (on retainer projects)" },
];
---

<BaseLayout
  title="About"
  description="elefox studio is a small development studio based in South Florida. Here's how we work."
>
  <!-- Hero -->
  <PageHeader
    title="A small studio that does the work most agencies pass on."
    accent="pass on"
    lede="elefox studio is a development studio in South Florida. We build websites, custom software, brand systems, and quiet little AI automations for small companies that have outgrown templates."
  />

  <!-- The founder (this used to be its own page at /about/founder) -->
  <section id="founder" class="pt-12 md:pt-20 pb-20 md:pb-32 scroll-mt-24">
    <Container size="full">
      <div data-reveal class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
        <figure class="lg:col-span-7">
          <img
            src="/people/tiffany-studio.webp"
            srcset="/people/tiffany-studio-960.webp 960w, /people/tiffany-studio.webp 1672w"
            sizes="(min-width: 1024px) 56vw, 100vw"
            alt="Tiffany Russell at her desk in the elefox studio, coffee mug and laptop in front of her"
            width="1672"
            height="941"
            loading="eager"
            decoding="async"
            class="w-full aspect-[16/10] object-cover object-[38%_30%] rounded-[24px] md:rounded-[32px]"
          />
        </figure>
        <div class="lg:col-span-5 lg:pb-6">
          <Eyebrow>The founder</Eyebrow>
          <h2 class="mt-5 max-w-[14ch]">
            Hi. I'm Tiffany. I started <span class="text-forest">elefox</span>.
          </h2>
          <p class="mt-8 flex items-center gap-3 text-sm text-graphite">
            <span class="w-8 h-px bg-ember inline-block"></span>
            Coral Springs, somewhere between coffee #2 and a deploy
          </p>
        </div>
      </div>

      <div class="mt-16 md:mt-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div data-reveal class="lg:col-span-7 space-y-8 text-lg md:text-xl text-graphite leading-relaxed">
          <p>
            I'm a UX designer and product builder based in Coral Springs, South
            Florida. I've worked across every flavor of the web (in-house,
            agency, freelance), and elefox is the studio I always wanted to run.
          </p>
          <p>
            What kept getting me hired wasn't one specialty. It was that I
            could figure out the plan, design it, and then write the code
            myself. A therapy practice that needed a real intake system. A
            realtor whose CRM was built for someone else. A financial planning
            firm that wanted a site that actually closed leads. It kept
            happening, so I built a studio around it.
          </p>
          <p>
            The studio is intentionally small. I'm the strategist, lead
            designer, frontend builder, and AI tinkerer on every engagement.
            A small group of collaborators I trust (engineers, illustrators,
            copywriters) plug in when a project calls for them. We cap our
            custom software roster at 25 active clients. We turn down work we
            can't make great. I'd rather do fewer projects really well.
          </p>
          <p>
            Years in, the part I still love is the same: making real things
            for people who needed something better than what was on offer.
            The tools have changed wildly. AI agents, modern frontend
            frameworks, and LLM pipelines are all in the kit now, and I keep
            learning the new stuff so what we ship doesn't feel dated two years
            after launch. The craft underneath hasn't changed one bit.
          </p>
          <p>
            The name? Long before it was a studio,
            <strong class="text-ink font-medium">elefox</strong> was my kids:
            elephants in my daughter's nursery, foxes in my son's, and a
            tattoo on my arm to keep them both close. When I needed a name
            that wasn't mine, theirs was the obvious one. The qualities happen
            to map, too: elephants remember and play the long game; foxes are
            clever and know when to bend the rules. That's how I want the
            studio to work.
          </p>
          <div class="pt-4 flex items-center gap-4">
            <span class="font-mono text-xs uppercase tracking-wider text-graphite">signed,</span>
            <span class="font-display font-bold text-3xl md:text-4xl tracking-tight text-forest">Tiffany</span>
          </div>
        </div>

        <aside data-reveal class="lg:col-span-4 lg:col-start-9">
          <dl class="lg:sticky lg:top-28 grid grid-cols-2 lg:grid-cols-1 gap-8 border-t border-fog pt-8">
            {
              facts.map((item) => (
                <div>
                  <dt class="font-mono text-xs uppercase tracking-wider text-forest mb-2">{item.t}</dt>
                  <dd class="text-lg text-ink leading-snug">{item.d}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
    </Container>
  </section>

  <!-- Principles -->
  <section class="py-20 md:py-32">
    <Container size="full" data-reveal>
      <div class="max-w-3xl mb-16 md:mb-20">
        <h2>Four principles we don't flex on.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        {
          principles.map((p) => (
            <article class="border-t-2 border-forest pt-8">
              <h3 class="text-2xl md:text-3xl text-ink mb-4">{p.t}</h3>
              <p class="text-lg text-graphite leading-relaxed">{p.p}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Collaborators -->
  <section class="py-6 md:py-12">
    <Container size="full">
      <div data-reveal class="bg-ink text-bone rounded-[28px] md:rounded-[40px] px-6 md:px-16 py-20 md:py-32">
        <div class="max-w-3xl mb-16">
          <h2 class="text-bone">
            One founder, plus the right people.
          </h2>
          <p class="lede text-bone/75 mt-6 text-xl">
            Tiffany runs elefox. When a job needs an extra specialist, she
            brings in collaborators she trusts. We won't pretend to be a
            40-person agency, but you do get more than one brain on your
            project.
          </p>
        </div>

        <div class="border-t border-bone/20">
          {
            collaborators.map((c) => (
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-8 border-b border-bone/20">
                <span class="md:col-span-5 text-xl text-bone font-display tracking-tight">{c.role}</span>
                <span class="md:col-span-7 text-lg text-bone/75 self-center">{c.scope}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <EndCTA
    heading="The worst outcome is a free conversation."
    primary={{ label: "Book a call", href: "/contact#book" }}
    secondary={{ label: "Send a message", href: "/contact" }}
  />
</BaseLayout>
