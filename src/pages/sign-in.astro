---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";

const portalUrl =
  import.meta.env.PORTAL_URL || "https://portal.tiffanyrussell.me";
---

<BaseLayout title="Sign in" description="Client sign-in for elefox studio.">
  <section class="py-32 md:py-48 min-h-[60vh] flex items-center">
    <Container size="default" class="text-center">
      <Eyebrow>Client sign-in</Eyebrow>
      <h1 class="mt-6 mb-8">Welcome back.</h1>
      <p class="lede mx-auto mb-12 text-xl">
        The client portal lives at a separate domain. Sign in to see your
        projects, files, contracts, and invoices.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <Button href={portalUrl} size="lg" external>Go to the portal</Button>
        <Button href="/contact" variant="secondary" size="lg">Not a client yet?</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
