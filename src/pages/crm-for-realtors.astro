    style="background-image:radial-gradient(at 20% 20%, rgba(63,90,46,0.35) 0px, transparent 50%),radial-gradient(at 80% 90%, rgba(200,98,58,0.18) 0px, transparent 55%);"
  >
    <Container size="full">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <Eyebrow tone="bone">Pricing</Eyebrow>
        <h2 data-split class="mt-6 text-bone">Pick the tier that fits where you are.</h2>
        <p class="lede mt-6 mx-auto text-center text-bone/70">
          Three setup tiers depending on how much marketing you want layered
          on. Hosting stays flat at $50/mo across all three. Unlimited team
          members, no per-seat fees.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {tiers.map((t) => (
          <article
            class={`rounded-2xl p-8 flex flex-col gap-3 ${t.featured ? "bg-ember/10 border-ember/40 shadow-ember" : "bg-bone/5 border-bone/10"} border`}
          >
            <p class="text-xs font-mono uppercase tracking-[0.14em] text-ember">{t.name}</p>
            <p class="font-display tracking-tight text-bone flex items-baseline gap-2">
              <span class="text-4xl font-bold">{t.price}</span>
              <span class="text-base text-bone/65">to {t.priceRange.split("–")[1].trim()}</span>
            </p>
            <p class="text-bone/85 leading-snug">{t.blurb}</p>
            <ul class="mt-3 space-y-2.5 flex-1">
              {t.features.map((f) => (
                <li class="flex gap-3 text-[15px] leading-snug text-bone/85">
                  <span class="text-ember shrink-0" aria-hidden="true">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto mt-10">
        <div class="bg-bone/5 border border-bone/10 rounded-xl p-6 text-center">
          <p class="text-[11px] font-mono uppercase tracking-[0.14em] text-bone/65 mb-2">Hosting · same across tiers</p>
          <p class="font-display text-bone tracking-tight"><span class="text-3xl font-bold">$50</span>/mo</p>
          <p class="text-sm text-bone/70 mt-2 leading-snug">Hosting, backups, security, bug fixes. Cancel anytime.</p>
        </div>
        <div class="bg-bone/5 border border-bone/10 rounded-xl p-6 text-center">
          <p class="text-[11px] font-mono uppercase tracking-[0.14em] text-bone/65 mb-2">Changes after launch</p>
          <p class="font-display text-bone tracking-tight"><span class="text-3xl font-bold">$150</span>/hr</p>
          <p class="text-sm text-bone/70 mt-2 leading-snug">Or flat-fee mini-projects when the scope is clear.</p>
        </div>
      </div>
    </Container>
