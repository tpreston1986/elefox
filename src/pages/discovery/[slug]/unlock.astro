---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
import { getForm } from "../../../data/discovery/forms";
import { hashPassphrase, isUnlocked, unlock } from "../../../data/discovery/gate";

export const prerender = false;

const { slug } = Astro.params;
const form = slug ? getForm(slug) : null;

if (!form) {
  return Astro.redirect("/404");
}
if (!form.passphraseHash || isUnlocked(Astro.cookies, form)) {
  return Astro.redirect(`/discovery/${form.slug}`);
}

let failed = false;
let empty = false;
if (Astro.request.method === "POST") {
  const fd = await Astro.request.formData();
  const attempt = String(fd.get("passphrase") ?? "");
  if (!attempt.trim()) {
    empty = true;
  } else if (hashPassphrase(attempt) === form.passphraseHash) {
    unlock(Astro.cookies, form);
    return Astro.redirect(`/discovery/${form.slug}`, 303);
  } else {
    failed = true;
  }
}
---

<BaseLayout title={`${form.title}, private form`} noindex bare>
  <section class="min-h-[85vh] flex items-center py-20">
    <Container size="default">
      <div class="mx-auto max-w-md bg-white border border-fog rounded-2xl p-8 md:p-10 text-center">
        <div
          class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-forest"
          aria-hidden="true"
        >
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <rect x="4" y="10.5" width="16" height="10.5" rx="2.5" stroke="#fff" stroke-width="1.9" />
            <path d="M7.5 10.5V7.5a4.5 4.5 0 0 1 9 0v3" stroke="#fff" stroke-width="1.9" />
          </svg>
        </div>
        <h1 class="text-3xl font-display tracking-tight text-ink">
          This form is just for you
        </h1>
        <p class="mt-3 text-graphite">
          Enter the passphrase Tiffany shared to open it.
        </p>

        <form method="post" class="mt-8 flex flex-col gap-3" novalidate>
          <label for="passphrase" class="sr-only">Passphrase</label>
          <input
            id="passphrase"
            name="passphrase"
            type="password"
            placeholder="Passphrase"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            autofocus
            aria-describedby={failed || empty ? "unlock-error" : undefined}
            class="w-full bg-bone border border-fog hover:border-mist focus:border-forest text-ink px-4 py-3 rounded-lg outline-none transition-colors text-center"
          />
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-forest text-bone rounded-pill text-lg font-medium hover:bg-forest-deep transition-colors"
          >
            Open the form
          </button>
        </form>

        {
          (failed || empty) && (
            <p
              id="unlock-error"
              role="alert"
              class="mt-5 rounded-lg border border-ember/40 bg-ember/5 px-4 py-3 text-sm text-ink"
            >
              {empty
                ? "Enter the passphrase to open the form."
                : "That passphrase didn't match. Check it and try again."}
            </p>
          )
        }

        <p class="mt-8 text-sm text-graphite">
          {form.title} · {form.subtitle}
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
