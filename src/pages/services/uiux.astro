---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import TierGrid from "../../components/TierGrid.astro";
import EndCTA from "../../components/EndCTA.astro";
import ServiceWork from "../../components/ServiceWork.astro";
import { services } from "../../data/services";

const s = services.uiux;
---

<BaseLayout title="UI/UX design" description={s.description}>
  <ServiceHero
    index="04"
    category={s.name}
    title={s.title}
    titleAccent={s.titleAccent}
    description={s.description}
  />

  <TierGrid
    tiers={s.tiers ?? []}
    eyebrow="How we design"
    heading="Wireframe to build-ready, however deep you need."
  />


  <ServiceWork
    service="uiux"
    heading="Products we've designed."
  />

  <EndCTA
    heading="If your product confuses people, let's fix that."
    primary={{ label: "Start a design project", href: "/contact?service=uiux" }}
  />
</BaseLayout>
