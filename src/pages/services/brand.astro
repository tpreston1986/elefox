---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import TierGrid from "../../components/TierGrid.astro";
import EndCTA from "../../components/EndCTA.astro";
import { services } from "../../data/services";

const s = services.brand;
---

<BaseLayout
  title="Brand & marketing"
  description={s.description}
>
  <ServiceHero
    index="03"
    category={s.name}
    title={s.title}
    titleAccent={s.titleAccent}
    description={s.description}
  />

  <TierGrid
    tiers={s.tiers ?? []}
    eyebrow="What's inside"
    heading="Brand as a system, not a one-off."
  />


  <EndCTA
    heading="Want to look as professional as you actually are?"
    primary={{ label: "Start a brand project", href: "/contact?service=brand" }}
  />
</BaseLayout>
