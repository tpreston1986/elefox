---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import HeroAtmosphere from "../../components/HeroAtmosphere.astro";
import { menuServices } from "../../data/services";
---

<BaseLayout
  title="Services"
  description="A free website audit, plus seven services — web, mobile, custom software, UI/UX, branding, testing, and early-stage builds — from elefox studio."
>
  <section class="pt-2 md:pt-4">
    <Container size="full">
      <div data-glow class="relative overflow-hidden rounded-[28px] md:rounded-[44px] pt-28 md:pt-36 pb-16 md:pb-24 px-6 md:px-12 bg-gradient-to-b from-[#FBF1E9] via-[#F8ECE0] to-[#F2E2D2]">
        <HeroAtmosphere warm />
        <div class="relative z-10 text-center max-w-4xl mx-auto">
          <Eyebrow>Services</Eyebrow>
          <h1 data-split class="display-xl mt-6 max-w-[18ch] mx-auto">
            Everything under
            <span class="whitespace-nowrap"><span class="text-gradient-flow">one roof</span>.</span>
          </h1>
          <p class="lede mt-10 max-w-3xl text-xl mx-auto text-center">
            Not sure where to start? Get a free website audit. Ready to build?
            Hire us for a single capability. Most clients come for one thing and
            stay for the others.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Free audit hook -->
  <section class="pt-12 md:pt-20 pb-4 md:pb-8">
    <Container size="full">
      <div data-reveal class="mb-8 md:mb-10">
        <Eyebrow>Start here</Eyebrow>
      </div>
      <a
        href="/audit"
        class="group relative block rounded-[24px] bg-forest text-bone p-8 md:p-14 overflow-hidden"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-8">
            <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.14em] text-bone/70 mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-ember" />
              Free · No strings
            </span>
            <h2 class="text-3xl md:text-5xl text-bone leading-[1.02] max-w-[16ch]">
              Get a free website audit
            </h2>
            <p class="text-bone/80 text-lg leading-relaxed mt-5 max-w-xl">
              Speed, mobile, SEO, and the things quietly losing you leads —
              reviewed by a real person, back to you in two business days. Yours
              to keep whether we work together or not.
            </p>
          </div>
          <div class="lg:col-span-4 lg:text-right">
            <span class="inline-flex items-center gap-2 px-6 py-3.5 bg-bone text-ink rounded-pill text-lg font-medium group-hover:gap-3 transition-all">
              Get my free audit
              <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </div>
      </a>
    </Container>
  </section>

  <!-- Capability services -->
  <section class="pt-12 md:pt-16 pb-32">
    <Container size="full" data-reveal>
      <div class="mb-4 md:mb-8">
        <Eyebrow>Or hire a capability</Eyebrow>
      </div>
      <div class="border-t border-fog">
        {
          menuServices.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="group grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 py-12 md:py-16 border-b border-fog hover:bg-cream/40 transition-colors -mx-6 md:-mx-10 px-6 md:px-10"
            >
              <div class="md:col-span-6">
                <h2 class="text-4xl md:text-6xl text-ink group-hover:text-forest transition-colors">
                  {s.name}
                </h2>
              </div>

              <div class="md:col-span-6 self-center">
                <p class="text-lg md:text-xl text-graphite leading-relaxed mb-6">
                  {s.oneLiner}
                </p>
                <span class="inline-flex items-center gap-2 text-sm font-medium text-forest tracking-tight">
                  See the work
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
                    <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-24 md:mt-32 text-center">
        <p class="lede mx-auto text-xl mb-8">
          Not sure where to start? Tell us where the friction is. We'll point
          you at the smallest first move, even if it isn't with us.
        </p>
        <Button href="/contact" size="lg">Start a conversation</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
