---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import TierGrid from "../../components/TierGrid.astro";
import EndCTA from "../../components/EndCTA.astro";
import Container from "../../components/Container.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { services } from "../../data/services";

const s = services.software;
---

<BaseLayout
  title="Custom software"
  description={s.description}
>
  <ServiceHero
    index="02"
    category={s.name}
    title={s.title}
    titleAccent={s.titleAccent}
    description={s.description}
  />

  <TierGrid
    tiers={s.tiers ?? []}
    eyebrow="What we build"
    heading="A CRM, a client portal, or the internal tool only your team needs."
  />

  <!-- Comparison block -->
  <section class="py-20 md:py-32">
    <Container size="full" data-reveal>
      <div class="max-w-3xl mb-16">
        <Eyebrow>Why custom</Eyebrow>
        <h2 class="mt-6">Off-the-shelf vs. built for you.</h2>
        <p class="lede mt-6">
          Most software is built for a made-up average customer. Your business has its own quirks.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            {
              t: "Off-the-shelf SaaS",
              p: "You adapt to their workflow. Pay per seat forever. Lose access if they sunset.",
              tone: "bg-cream border-fog",
            },
            {
              t: "No-code builders",
              p: "Quick to set up, until you hit the ceiling. And you're still locked into their platform.",
              tone: "bg-cream border-fog",
            },
            {
              t: "Custom (us)",
              p: "Uses your words and your workflow. We host it from $50/mo, and you can take it with you whenever you want.",
              tone: "bg-forest text-bone border-forest",
            },
          ].map((c) => (
            <div class={`border ${c.tone} p-8 md:p-10 rounded-xl`}>
              <h3 class={`text-2xl mb-4 ${c.tone.includes('forest') ? 'text-bone' : 'text-ink'}`}>{c.t}</h3>
              <p class={`text-lg leading-relaxed ${c.tone.includes('forest') ? 'text-bone/80' : 'text-graphite'}`}>{c.p}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>


  <!-- 25-client cap notice -->
  <section class="py-6 md:py-12">
    <Container size="full">
      <div data-reveal class="bg-ink text-bone rounded-[28px] md:rounded-[40px] px-6 md:px-16 py-20 md:py-32">
        <Eyebrow tone="bone">A note on availability</Eyebrow>
        <p class="text-3xl md:text-4xl font-display tracking-tight leading-tight mt-6 max-w-3xl">
          We cap our custom software roster at 25 active clients, so builds
          keep moving and support stays personal. If we're full when you reach
          out, we'll tell you straight.
        </p>
      </div>
    </Container>
  </section>

  <EndCTA
    heading="Got a workflow nothing seems to fit? Bring it to us."
    primary={{ label: "Start a software project", href: "/contact?service=software" }}
  />
</BaseLayout>
