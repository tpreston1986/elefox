---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import TierGrid from "../../components/TierGrid.astro";
import EndCTA from "../../components/EndCTA.astro";
import Container from "../../components/Container.astro";
import WorkStage from "../../components/WorkStage.astro";
import { services } from "../../data/services";

const s = services.mobile;
---

<BaseLayout title="Mobile development" description={s.description}>
  <ServiceHero
    index="02"
    category={s.name}
    title={s.title}
    titleAccent={s.titleAccent}
    description={s.description}
  />

  <TierGrid
    tiers={s.tiers ?? []}
    eyebrow="What we build"
    heading="From a first app to a game with real players."
  />


  <!-- Our own app: Cove -->
  <section class="pb-24 md:pb-40">
    <Container size="full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center border-t border-fog pt-14 md:pt-20">
        <div data-reveal class="lg:col-span-5">
          <h2 class="max-w-[16ch]">We ship our own apps, too.</h2>
          <p class="mt-6 text-lg md:text-xl text-graphite leading-relaxed max-w-xl">
            Cove: Ocean Puzzles is our puzzle game for iOS and Android. It has
            four modes (Tide Blocks, Reef Sudoku, Tide Pool, and Word Tide)
            and a reef you fill with sea creatures as you play. Designed and
            built in-house with React Native and Expo.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href="/work/cove" class="group inline-flex items-center gap-2 text-forest font-medium hover:gap-3 transition-all">
              See the Cove case study
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h11m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a href="https://apps.apple.com/us/app/cove-ocean-puzzles/id6784039394" target="_blank" rel="noopener noreferrer" class="text-graphite hover:text-forest underline-offset-4 hover:underline">App Store</a>
            <a href="https://play.google.com/store/apps/details?id=com.elefox.cove" target="_blank" rel="noopener noreferrer" class="text-graphite hover:text-forest underline-offset-4 hover:underline">Google Play</a>
          </div>
        </div>
        <div data-reveal class="lg:col-span-6 lg:col-start-7">
          <div class="cove-panel ws-host rounded-[24px] overflow-hidden">
            <WorkStage
              thumb={{ kind: "phones", screens: ["/work/cove-menu.webp", "/work/cove-words.webp", "/work/cove-reef.webp"] }}
              ratio="16 / 11"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <EndCTA
    heading="Got an app or game to ship? Let's scope it."
    primary={{ label: "Start a mobile project", href: "/contact?service=mobile" }}
  />
</BaseLayout>

<style>
  .cove-panel {
    position: relative;
    isolation: isolate;
    background: #0c2b4a;
  }
  .cove-panel::before {
    content: "";
    position: absolute;
    inset: -30% -10% 20% -10%;
    z-index: -1;
    background: radial-gradient(55% 60% at 50% 20%, #3fc4d4, transparent 72%);
    opacity: 0.35;
    pointer-events: none;
  }
</style>
