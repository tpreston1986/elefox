---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import TierGrid from "../../components/TierGrid.astro";
import EndCTA from "../../components/EndCTA.astro";
import { services } from "../../data/services";

const s = services["early-stage"];
---

<BaseLayout title="Custom build for early-stage business" description={s.description}>
  <ServiceHero
    index="07"
    category={s.name}
    title={s.title}
    titleAccent={s.titleAccent}
    description={s.description}
  />

  <TierGrid
    tiers={s.tiers ?? []}
    eyebrow="Ways to start"
    heading="One team for the whole first version."
  />


  <EndCTA
    heading="Getting a business off the ground? Let's build it together."
    primary={{ label: "Start an early-stage build", href: "/contact?service=early-stage" }}
  />
</BaseLayout>
