---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import EndCTA from "../components/EndCTA.astro";
import HeroAtmosphere from "../components/HeroAtmosphere.astro";

const projects = [
  {
    title: "Client Portal",
    tag: "Product · Full-stack web",
    image: "/work/portal.webp",
    domain: "portal.elefoxstudio.com",
    body: "Most freelancers cobble together five different tools to run their business, and it shows. So we built one thing that does all of it. A full-stack client-facing portal (project status, contracts, invoices, files, messages, approvals) plus a complete admin CRM (leads, clients, quotes, projects). Stripe for payments, S3 for file delivery, role-based auth so clients only ever see their own data. Self-hosted, zero per-seat fees.",
    stack: ["Next.js", "Prisma", "PostgreSQL", "Stripe", "AWS S3", "Resend", "Railway"],
  },
  {
    title: "Pulse",
    tag: "Product · Internal tool",
    image: "/work/pulse.webp",
    domain: "internal · Plane on Railway",
    body: "A company was paying $2,500 a month for Jira. We built them something better. A fully customized project management system on Plane (open-source) deployed in-house on Railway. Configured across five departments (Ops, Dev, Paid Marketing, Content, Design) with custom kanban statuses, timesheet logging, and a time-reports dashboard filterable by person, business unit, and project. Eliminated $30K/year in licensing.",
    stack: ["Plane (open-source)", "Railway", "Figma"],
  },
  {
    title: "SavingsXL",
    tag: "Brand · Full-stack web",
    image: "/work/savingsxl.webp",
    domain: "savingsxl.com",
    body: "A member savings product that needed everything: brand, design, and a working site, all built from the ground up. Started by extending the existing logo into a full visual identity, then designed the marketing site in Figma, then built the whole thing: Astro front end, Strapi headless CMS, deployed on Railway. Soup to nuts.",
    stack: ["Astro", "Strapi", "Railway", "Figma"],
  },
  {
    title: "RKG Therapy",
    tag: "Brand · Web design · Development",
    image: "/work/rkg.webp",
    domain: "rkgtherapy.com",
    body: "A Coral Springs therapy practice offering individual, couples, and family work in person and online. The brief was simple: feel human, not clinical. Most people searching for a therapist are already anxious; the site needed to meet them there, not make it worse. The result is a warm editorial design with bold serif type, lavender and cream tones, and copy written for the person who's never done this before.",
    stack: ["Figma", "Astro", "HTML/CSS/JS"],
  },
];
---

<BaseLayout
  title="Selected work"
  description="A few things we've built, internal tools, marketing sites, and editorial work for the small businesses we work with."
>
  <!-- Hero -->
  <section data-glow class="relative overflow-hidden pt-24 md:pt-36 pb-16 md:pb-20">
    <HeroAtmosphere />
    <Container size="full" class="relative z-10 text-center">
      <Eyebrow>Selected work</Eyebrow>
      <h1 data-split class="display-xl mt-6 max-w-[18ch] mx-auto">
        A few things we've
        <span class="text-gradient-flow">made</span>.
      </h1>
      <p class="lede mt-10 text-xl max-w-3xl mx-auto text-center">
        The roster is small on purpose. Each one of these took the kind of
        attention that doesn't scale, and that's the point. Full case studies
        are still being written. Want the deeper version of any of these?
        <a href="/contact" class="text-forest underline decoration-2 underline-offset-4 hover:decoration-ember">Ask us</a>.
      </p>
    </Container>
  </section>

  <!-- Project list -->
  <section class="pb-24 md:pb-40">
    <Container size="full" data-reveal>
      <div class="space-y-20 md:space-y-32">
        {
          projects.map((p, i) => (
            <article
              data-reveal
              class={`grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-center ${i % 2 === 1 ? "md:[direction:rtl]" : ""}`}
            >
              <div class="md:col-span-7 md:[direction:ltr] group">
                <div class="relative aspect-[4/3] rounded-xl overflow-hidden bg-ink shadow-soft">
                  <img
                    src={p.image}
                    alt={`${p.title}, ${p.tag}`}
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover grayscale contrast-[1.05] brightness-[0.95] group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-700"
                    onerror="this.style.display='none'"
                  />
                  <div class="absolute inset-0 bg-forest mix-blend-multiply opacity-40 group-hover:opacity-0 transition-opacity duration-700 pointer-events-none" />
                  <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/35 to-transparent pointer-events-none" />
                  <div class="absolute inset-x-0 top-0 p-5 md:p-7 flex items-center justify-between">
                    <div class="flex gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-bone/70" />
                      <span class="w-2.5 h-2.5 rounded-full bg-bone/70" />
                      <span class="w-2.5 h-2.5 rounded-full bg-bone/70" />
                    </div>
                    <span class="text-[10px] md:text-xs font-mono text-bone tracking-wider">
                      {p.domain}
                    </span>
                  </div>
                </div>
              </div>

              <div class="md:col-span-5 md:[direction:ltr]">
                <span class="font-mono text-xs uppercase tracking-[0.14em] text-forest">
                  {p.tag}
                </span>
                <h2 class="text-3xl md:text-5xl text-ink mt-4 mb-6 font-display tracking-tight">
                  {p.title}
                </h2>
                <p class="text-lg text-graphite leading-relaxed mb-6">{p.body}</p>
                <div class="flex flex-wrap gap-2">
                  {p.stack.map((s) => (
                    <span class="text-xs font-mono text-graphite bg-cream px-2 py-1 rounded-md">
                      {s}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <EndCTA
    heading="Want the full story behind any of these?"
    primary={{ label: "Get in touch", href: "/contact" }}
    secondary={{ label: "Book a call", href: "/contact#book" }}
  />
</BaseLayout>
