---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import EndCTA from "../components/EndCTA.astro";
import HeroAtmosphere from "../components/HeroAtmosphere.astro";
import WorkCard from "../components/WorkCard.astro";
import { projects, SERVICES } from "../data/work";

const filters = ["All", ...SERVICES];
---

<BaseLayout
  title="Work"
  description="Client websites, full-stack web apps, and our own software products, designed and built by elefox studio for small businesses."
>
  <!-- Hero -->
  <section class="pt-2 md:pt-4">
    <Container size="full">
      <div data-glow class="relative overflow-hidden rounded-[28px] md:rounded-[44px] pt-28 md:pt-36 pb-16 md:pb-20 px-6 md:px-12 bg-gradient-to-b from-[#FBF1E9] via-[#F8ECE0] to-[#F2E2D2]">
        <HeroAtmosphere warm />
        <div class="relative z-10 max-w-4xl">
          <Eyebrow>Work</Eyebrow>
          <h1 data-split class="display-xl mt-6 max-w-[16ch]">
            Things we've
            <span class="text-gradient-flow">built.</span>
          </h1>
          <p class="lede mt-8 text-xl max-w-2xl">
            Sites and apps for real small businesses, plus a few products of
            our own that we built because we wanted them to exist. Most are
            live, and a few are still in the lab.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Filters -->
  <section class="pt-10 md:pt-14">
    <Container size="full">
      <div data-reveal class="flex flex-wrap gap-2 md:gap-3" role="group" aria-label="Filter work by service">
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f}
              class:list={[
                "work-pill px-4 py-2 rounded-pill text-sm font-medium tracking-tight border transition-colors",
                i === 0
                  ? "is-active bg-ink text-bone border-ink"
                  : "bg-transparent text-ink border-mist hover:border-forest hover:text-forest",
              ]}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {f}
            </button>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Grid: three across, middle column dropped a step (Movadex-style) -->
  <section class="pt-8 md:pt-12 pb-24 md:pb-40">
    <Container size="full">
      <div id="work-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {
          projects.map((p, i) => (
            <article class:list={["work-card", i % 3 === 1 && "is-mid"]} data-services={p.services.join("|")}>
              <WorkCard project={p} headingLevel="h2" />
            </article>
          ))
        }
      </div>

      <p id="work-empty" class="hidden text-center text-graphite text-lg py-16">
        Nothing under that filter yet.
      </p>
    </Container>
  </section>

  <EndCTA
    heading="Want something like this, built for you?"
    primary={{ label: "Start a project", href: "/contact" }}
    secondary={{ label: "Get a free audit", href: "/audit" }}
  />

  <style>
    /* Drop the middle column so the grid reads as a stagger, not a table. */
    @media (min-width: 1024px) {
      .work-card.is-mid {
        transform: translateY(4.5rem);
      }
    }
  </style>

  <script is:inline>
    (() => {
      const pills = Array.from(document.querySelectorAll(".work-pill"));
      const cards = Array.from(document.querySelectorAll(".work-card"));
      const empty = document.getElementById("work-empty");
      if (!pills.length) return;

      const setActive = (active) => {
        pills.forEach((p) => {
          const on = p === active;
          p.classList.toggle("is-active", on);
          p.classList.toggle("bg-ink", on);
          p.classList.toggle("text-bone", on);
          p.classList.toggle("border-ink", on);
          p.classList.toggle("bg-transparent", !on);
          p.classList.toggle("text-ink", !on);
          p.classList.toggle("border-mist", !on);
          p.setAttribute("aria-pressed", on ? "true" : "false");
        });
      };

      pills.forEach((pill) => {
        pill.addEventListener("click", () => {
          const f = pill.dataset.filter;
          setActive(pill);
          let shown = 0;
          cards.forEach((card) => {
            const services = (card.dataset.services || "").split("|");
            const show = f === "All" || services.includes(f);
            card.style.display = show ? "" : "none";
            card.classList.toggle("is-mid", show && shown % 3 === 1);
            if (show) shown++;
          });
          if (empty) empty.classList.toggle("hidden", shown > 0);
        });
      });
    })();
  </script>
</BaseLayout>
