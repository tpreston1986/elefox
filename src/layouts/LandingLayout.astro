---
// Distraction-free chrome for paid-traffic landing pages: logo + a single
// "Book a call" action, no nav. Minimal footer with contact + legal only.
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  description?: string;
  ogImage?: string;
};

const { title, description, ogImage } = Astro.props;

const calendlyUrl =
  import.meta.env.CALENDLY_URL ||
  "https://calendly.com/contact-tiffanyrussell/discovery-call";

const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description} ogImage={ogImage} bare>
  <!-- Floating pill bar (distraction-free: logo + single action, no nav) -->
  <header class="nav-floating">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="nav-pill flex items-center justify-between gap-3 h-14 md:h-16 pl-4 pr-2 md:pl-6 md:pr-3">
        <a href="/" class="flex items-center shrink-0" aria-label="elefox studio, home">
          <img
            src="/brand/logo-horizontal.png"
            alt="elefox studio"
            class="h-6 md:h-7 w-auto"
            loading="eager"
            fetchpriority="high"
            width="790"
            height="100"
          />
        </a>
        <div class="flex items-center gap-3 md:gap-4 shrink-0">
          <a
            href="tel:+19547806508"
            class="hidden sm:inline text-sm font-medium text-graphite hover:text-forest transition-colors"
          >
            954.780.6508
          </a>
          <a
            href={calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-forest text-bone rounded-pill text-sm font-medium hover:bg-forest-deep transition-colors"
          >
            Book a call
          </a>
        </div>
      </div>
    </div>
  </header>

  <slot />

  <!-- Minimal footer, as a contained card -->
  <footer class="pt-6 md:pt-10 pb-2 md:pb-4">
    <div class="mx-auto max-w-[1600px] px-2 md:px-4">
      <div class="bg-ink text-bone/80 rounded-[28px] md:rounded-[40px] px-6 md:px-12 py-10">
        <div class="mx-auto max-w-6xl flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm">
          <div class="flex items-center gap-3">
            <img src="/brand/logo-horizontal-white.png" alt="elefox studio" class="h-6 w-auto" width="790" height="100" />
          </div>
          <p class="text-bone/60">
            © {year} elefox studio · Coral Springs, FL ·
            <a href="tel:+19547806508" class="hover:text-bone">954.780.6508</a> ·
            <a href="mailto:hello@elefoxstudio.com" class="hover:text-bone">hello@elefoxstudio.com</a> ·
            <a href="/privacy" class="hover:text-bone">Privacy</a>
          </p>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
