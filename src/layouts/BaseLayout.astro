---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Standalone mode: drop the site header + footer for focused pages
   *  (e.g. discovery forms sent directly to a prospect). */
  bare?: boolean;
};

const {
  title,
  description = "elefox studio builds custom tools, CRMs, client portals, and booking systems, shaped around how your business runs, plus the website that ties them together.",
  ogImage = "/og/default.png",
  noindex = false,
  bare = false,
} = Astro.props;

const fullTitle = title.includes("elefox studio")
  ? title
  : `${title} · elefox studio`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://elefoxstudio.com").toString();

// Site-wide structured data: identity, contact, local business, and social
// profiles. Satisfies the "schema / identity / local business" SEO checks.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://elefoxstudio.com/#org",
  name: "elefox studio",
  legalName: "Tiffany Russell Studio LLC",
  url: "https://elefoxstudio.com",
  logo: "https://elefoxstudio.com/brand/logo-horizontal.png",
  image: "https://elefoxstudio.com/og/default.png",
  email: "hello@elefoxstudio.com",
  telephone: "+1-954-780-6508",
  founder: { "@type": "Person", name: "Tiffany Russell" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Coral Springs",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: { "@type": "Country", name: "United States" },
  description:
    "elefox studio builds custom tools, CRMs, client portals, and booking systems shaped around how your business runs, plus the website that ties them together.",
  sameAs: [
    "https://www.instagram.com/elefoxstudio/",
    "https://www.linkedin.com/company/elefoxstudio/",
    "https://www.facebook.com/elefoxstudio/",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "elefox studio",
  url: "https://elefoxstudio.com",
  publisher: { "@id": "https://elefoxstudio.com/#org" },
};

// Google Analytics 4. Set when PUBLIC_GA4_ID (G-XXXXXXX) is configured;
// renders nothing otherwise (e.g. local dev).
const ga4Id = import.meta.env.PUBLIC_GA4_ID || "";

// Meta (Facebook) Pixel. Set PUBLIC_META_PIXEL_ID (15-16 digit number) to
// enable. Renders nothing otherwise. Respects the same ?noga opt-out flag.
// We assemble the markup as a raw HTML string and inject via Fragment
// set:html — Astro's <script is:inline> transform chokes on the standard
// Meta Pixel snippet (the nested braces in the IIFE), so we sidestep it.
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || "";
const metaPixelMarkup = (() => {
  if (!metaPixelId) return "";
  const stub =
    "!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');";
  const init =
    "try{if(localStorage.getItem('elefox_noga')!=='1'){fbq('init','" +
    metaPixelId +
    "');fbq('track','PageView');}}catch(e){fbq('init','" +
    metaPixelId +
    "');fbq('track','PageView');}";
  return (
    "<script>" +
    stub +
    init +
    "</script><noscript><img height=\"1\" width=\"1\" style=\"display:none\" src=\"https://www.facebook.com/tr?id=" +
    metaPixelId +
    "&ev=PageView&noscript=1\" /></noscript>"
  );
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, canonical).toString()} />
    <meta property="og:site_name" content="elefox studio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonical).toString()} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Theme -->
    <meta name="theme-color" content="#3f5a2e" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Caveat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Cloudflare Web Analytics -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "bc93bb58a01c445e99816377bfdda5dc"}'
    ></script>
    <!-- End Cloudflare Web Analytics -->

    {/* Google Analytics 4 */}
    {
      ga4Id && (
        <>
          {/* Personal opt-out: visit ?noga=1 once on a device to stop GA
              counting you (testing). ?noga=0 re-enables. Persists per-browser
              and must run before gtag config sets the disable flag. */}
          <script
            is:inline
            set:html={`(function(){try{var p=new URLSearchParams(location.search);if(p.has('noga')){if(p.get('noga')==='0'){localStorage.removeItem('elefox_noga')}else{localStorage.setItem('elefox_noga','1')}}if(localStorage.getItem('elefox_noga')==='1'){window['ga-disable-${ga4Id}']=true;}}catch(e){}})();`}
          />
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
          <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');`} />
        </>
      )
    }

    {/* Meta (Facebook) Pixel — gated on PUBLIC_META_PIXEL_ID. Respects the
        same ?noga opt-out flag. Injected via Fragment set:html so Astro
        doesn't process the script content (which trips its inline-script
        transform on this particular IIFE pattern). */}
    {metaPixelId && <Fragment set:html={metaPixelMarkup} />}
  </head>
  <body class="min-h-screen flex flex-col">
    {
      !bare && (
        <a
          href="#main"
          class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:bg-forest focus:text-bone focus:px-4 focus:py-2 focus:rounded-pill focus:z-50"
        >
          Skip to content
        </a>
      )
    }
    {!bare && <Header />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}

    {/* Cookie notice (informational, non-blocking, US-style) */}
    <div
      id="cookie-note"
      class="hidden fixed bottom-4 inset-x-4 md:inset-x-auto md:right-6 md:max-w-md z-50 bg-ink text-bone rounded-xl shadow-lift px-4 py-3 md:px-5 md:py-4 flex items-center gap-3"
    >
      <p class="text-xs sm:text-sm text-bone/85 leading-snug flex-1 min-w-0">
        We use cookies for analytics.
        <a href="/privacy" class="underline hover:text-bone">Learn more</a>.
      </p>
      <button
        id="cookie-ok"
        class="shrink-0 px-4 py-2 bg-bone text-ink rounded-pill text-sm font-medium hover:bg-cream transition-colors"
      >
        Got it
      </button>
    </div>
    <script is:inline>
      (function () {
        try {
          var el = document.getElementById("cookie-note");
          if (!el) return;
          if (!localStorage.getItem("elefox_cookie_ok")) el.classList.remove("hidden");
          var b = document.getElementById("cookie-ok");
          if (b)
            b.addEventListener("click", function () {
              try { localStorage.setItem("elefox_cookie_ok", "1"); } catch (e) {}
              el.classList.add("hidden");
            });
        } catch (e) {}
      })();
    </script>

    <script>
      import Lenis from "lenis";

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      // -- Smooth scrolling (Lenis) -----------------------------------------
      // Skipped entirely if the user has reduced-motion set.
      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.15,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      // -- Word-by-word headline reveal ------------------------------------
      // Any element with `data-split` gets its visible text content split
      // into per-word <span>s that translate up + fade in on scroll.
      // Children that are already elements (em, span, etc.) get kept intact
      // and treated as one unit so brand SVGs/underlines don't break.
      const splitTargets =
        document.querySelectorAll<HTMLElement>("[data-split]");

      splitTargets.forEach((el) => {
        const fragment = document.createDocumentFragment();
        el.childNodes.forEach((node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.textContent ?? "";
            const parts = text.split(/(\s+)/);
            parts.forEach((part) => {
              if (!part) return;
              if (/^\s+$/.test(part)) {
                fragment.appendChild(document.createTextNode(" "));
              } else {
                const wrap = document.createElement("span");
                wrap.className = "split-word";
                const inner = document.createElement("span");
                inner.className = "split-word__inner";
                inner.textContent = part;
                wrap.appendChild(inner);
                fragment.appendChild(wrap);
              }
            });
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            const wrap = document.createElement("span");
            wrap.className = "split-word";
            const inner = document.createElement("span");
            inner.className = "split-word__inner";
            inner.appendChild(node.cloneNode(true));
            wrap.appendChild(inner);
            fragment.appendChild(wrap);
          }
        });
        el.innerHTML = "";
        el.appendChild(fragment);
        el.setAttribute("data-split-ready", "");
      });

      // -- Reveal elements as they scroll into view -------------------------
      const revealTargets = document.querySelectorAll<HTMLElement>(
        "[data-reveal], [data-split], [data-reveal-stagger]"
      );
      if (revealTargets.length && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                const el = e.target as HTMLElement;
                // Stagger word reveals if this is a split element
                if (el.hasAttribute("data-split")) {
                  const words = el.querySelectorAll<HTMLElement>(
                    ".split-word__inner"
                  );
                  words.forEach((w, i) => {
                    w.style.transitionDelay = `${i * 45}ms`;
                  });
                }
                el.setAttribute("data-revealed", "");
                io.unobserve(el);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );
        revealTargets.forEach((t) => io.observe(t));
      } else {
        revealTargets.forEach((t) => t.setAttribute("data-revealed", ""));
      }

      // -- Pinned horizontal-scroll sections -------------------------------
      // A `[data-horiz]` section is taller than viewport. Its first child
      // (.horiz__inner) is sticky to the top of the viewport, and a child
      // .horiz__track translates left as the user scrolls through the
      // outer section.
      const horizSections =
        document.querySelectorAll<HTMLElement>("[data-horiz]");

      horizSections.forEach((section) => {
        const track = section.querySelector<HTMLElement>(".horiz__track");
        const inner = section.querySelector<HTMLElement>(".horiz__inner");
        if (!track || !inner) return;

        let trackWidth = 0;
        let sectionHeight = 0;

        const measure = () => {
          // The track's natural scroll width is what we need to translate by.
          trackWidth = track.scrollWidth;
          const viewportWidth = window.innerWidth;
          const distance = Math.max(0, trackWidth - viewportWidth);
          // Section needs to be tall enough that scrolling its full height
          // produces the horizontal distance we need.
          sectionHeight = window.innerHeight + distance;
          section.style.height = `${sectionHeight}px`;
        };

        measure();
        window.addEventListener("resize", measure);

        const onScroll = () => {
          const rect = section.getBoundingClientRect();
          const total = sectionHeight - window.innerHeight;
          // progress: 0 when section top hits viewport top, 1 when section
          // bottom hits viewport bottom (the inner pin releases).
          const raw = -rect.top / Math.max(1, total);
          const progress = Math.min(1, Math.max(0, raw));
          const distance = Math.max(0, track.scrollWidth - window.innerWidth);
          track.style.transform = `translate3d(${-distance * progress}px, 0, 0)`;
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      });

      // -- Cursor-follow glow ----------------------------------------------
      // Any [data-glow] section with a .cursor-glow child gets a soft glow
      // that trails the pointer. Skipped for touch + reduced-motion.
      if (
        !prefersReducedMotion &&
        !window.matchMedia("(hover: none)").matches
      ) {
        const glowSections =
          document.querySelectorAll<HTMLElement>("[data-glow]");
        glowSections.forEach((section) => {
          const glow = section.querySelector<HTMLElement>(".cursor-glow");
          if (!glow) return;
          let raf = 0;
          section.addEventListener("pointermove", (e) => {
            const r = section.getBoundingClientRect();
            const x = e.clientX - r.left;
            const y = e.clientY - r.top;
            if (raf) return;
            raf = requestAnimationFrame(() => {
              glow.style.setProperty("--gx", x + "px");
              glow.style.setProperty("--gy", y + "px");
              raf = 0;
            });
          });
        });
      }

      // -- Intent events (GA4) ---------------------------------------------
      // Track high-signal clicks: booking a call, tapping the phone, email.
      // gtag respects the ga-disable opt-out, so the owner's own taps (?noga=1)
      // are excluded automatically.
      const track = (name: string, params: Record<string, unknown>) => {
        const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
        if (typeof g === "function") g("event", name, params);
      };
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        const a = target?.closest?.("a");
        if (!a) return;
        const href = a.getAttribute("href") || "";
        if (href.includes("calendly.com")) {
          track("book_call_click", { page: location.pathname });
        } else if (href.startsWith("tel:")) {
          track("phone_click", { page: location.pathname });
        } else if (href.startsWith("mailto:")) {
          track("email_click", { page: location.pathname });
        }
      });
    </script>
  </body>
</html>
