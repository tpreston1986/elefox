# Public
SITE_URL=https://elefoxstudio.com
CALENDLY_URL=https://calendly.com/contact-tiffanyrussell/discovery-call
PORTAL_URL=https://portal.elefoxstudio.com

# Spam protection — Cloudflare Turnstile (recommended for the contact + audit forms).
# When BOTH keys are set, form submissions verify a human-challenge token server-side.
# If they're unset, Turnstile is skipped — the honeypot, 3s timing trap, per-IP rate
# limit, and content spam-scoring still apply, but this is the strongest layer.
# Get keys at dash.cloudflare.com → Turnstile (site key is public, secret is not).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email — powers /api/contact and /api/discovery
RESEND_API_KEY=
RESEND_FROM="elefox studio <hello@elefoxstudio.com>"
REPLY_TO_EMAIL=hello@elefoxstudio.com
# Optional: route form notifications to a different inbox (defaults to REPLY_TO_EMAIL)
DISCOVERY_NOTIFY_EMAIL=

# Newsletter (not wired)
RESEND_AUDIENCE_ID=

# AI — optional, adds an AI summary to discovery notification emails
ANTHROPIC_API_KEY=

# Portal webhook — creates a CRM Lead row when forms are submitted.
# PORTAL_LEADS_WEBHOOK_SECRET must match LEADS_API_SECRET on the portal service.
PORTAL_LEADS_WEBHOOK_URL=https://portal.elefoxstudio.com/api/leads
PORTAL_LEADS_WEBHOOK_SECRET=
